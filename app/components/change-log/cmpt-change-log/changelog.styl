@import "common-var.styl"

.cmpt-change-log {
}

.cmpt-inline {
	display: inline;
}

div.qtipChangeLog {
	padding: 2px;

	//some min dimensions so the loader looks reasonable
	min-height: 15px;
	min-width: 130px;

	.loader{
		//trying to center the loader
		margin-top: -4px;
		.loading-container{
			position: initial;
		}
	}
	div.row {
		padding-bottom: 3px;
	}
	div.qtip-label {
		color: ap-dark-grey-3;
		margin-bottom: 4px;
	}
	span.label {
		font-weight: bold;
	}
}