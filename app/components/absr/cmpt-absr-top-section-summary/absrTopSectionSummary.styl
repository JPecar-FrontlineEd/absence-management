@import "common-var"
.cmpt-absr-top-section-summary {
	font-size: 14px;

	.-g {
		margin-bottom: 10px;
	}

	.top-details{
		width: 100%;

		.left-section {
			text-align:left;

			.all-dates {
				font-size: 20px;
			}
		}

		.right-section{
			text-align:right;

			.cmpt-template-approval {
				display: inline-block;
			}

			.details {
				color: subTitle-color-light;
			}

			.return {
				margin-top: 10px;
			}
		}
	}

	.entry-id, .worker-title {
		font-weight: 700;
	}

	.bold {
		font-weight: 700;
	}

	.related-abs-container {
		width: 100%;
		overflow: hidden;
		margin: 10px 0;
		border: 1px solid borderColor-medium;
		padding: 10px;
		background-color: backGroundColor;

		label {
			display: block;
			float: left;
			font-weight: bold;
			margin-right: 10px;
		}
	}

	.renotify-substitute {
		margin-top: 10px;
	}

	.worker-title {
		max-width: 400px;
		display: inline-block;
		word-break: break-all;
		font-size: inherit;
		margin-left: 4px;
	}

}
