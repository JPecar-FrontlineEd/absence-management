@import "common-var"
.cmpt-absr-done-bottom-bar {
	background: greyBar-backGroundColor;
	color: subTitle-color-darkest;
	border-top: 1px solid borderColor-medium;
	padding: 10px 12px;
	width:100%;

	.fa.fa-spinner.fa-spin {
		margin-right: 5px;
		display: inline-block;
	}

	.fl-label {
		display: inline-block;
	}

	.hold-for-30 {
		display: inline-block;
		margin-left: 0.5rem;
		font-size: 14px;
		font-weight: 600px;
	}

}
