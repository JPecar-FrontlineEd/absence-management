        position: relative;
        
    }
    .undo-delete > div{
        position: absolute;
        width: 134px;
        right: 0;
        background: #f1f3f5;
        border: 1px solid #c0c8cf;
        padding: 1px 5px 2px 5px;
        border-radius: 10px;
        color: #2e7ab8;
        font-weight: bold;
        font-family: 'Open Sans', sans-serif;
        margin-right:-12px;
        cursor: default;
        margin-top: -2px;
        
    }
