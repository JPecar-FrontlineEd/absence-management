@import "common-var"
.cmpt-absr-details-notes {
	.section-header {
		background: gradient-greenBar-backGroundColor;
		background: gradient-greenBar;
		zoom: 1;
		border-bottom: 1px solid gradient-greenBar-borderColor;
		color: gradient-greenBar-color;
		font-weight: bold;
		padding: 9px 10px;
		position:relative;
		font-size:14px;
		width: 100%;

		div {
			border-left: 1px solid gradient-greenBar-borderColor;
			position: absolute;
			top: 0;
			right: 0;
			bottom: 0;
			width: 46px;
			z-index: 1;
			text-align:center;
			font-size:26px;
		}

		.notes-toggler {
			cursor: pointer;

			&.expanded {
				background: gradient-greenBar-backGroundColor;
				background: gradient-greenBar-reverse;
			}

			&:focus{
				border: 1px solid #bbbbbb;
				box-shadow: inset 0 1px 3px 0 rgba(0, 0, 0, 0.1);
				outline: none;
			}
		}
	}

	.cmpt-ui-textarea {
		display: inline-block;
		margin: 10px 14px 0 14px;
	}

	.admin-notes, .substitute-notes {
		width: 46%;

		textarea {
			width: 340px;
			max-width: 340px;
			min-width: 340px;

			min-height: 100px;
			max-height: 150px;
		}
	}

	.admin-only-notes {
		width: 96%;

		textarea {
			width: 710px;
			max-width: 710px;
			min-width: 710px;

			min-height: 100px;
			max-height: 150px;
		}
	}

	.section-notes {
		hyphenate();
	}

	.section-divider {
		border-bottom: 1px solid borderColor-medium;
		padding: 5px 0;
		margin: 0 15px 0 15px;
	}
}
