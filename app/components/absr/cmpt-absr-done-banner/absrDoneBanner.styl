@import "common-var"
.cmpt-absr-done-banner {
	width: 100%;
	display: inline-block;
	padding: 15px 40px;
	margin-bottom: 10px;
	border: 2px solid ap-dark-green;
	background: ap-light-green;

	.success {
		display: block;
		font-size: 50px;
		text-align: center;
		line-height: 50px;
	}

	.message {
		font-size: 1.5rem;
		display: block;
		text-align: center;
		width: 100%;
		font-weight: 600;

		.sub-message {
			font-size: 1rem;
			font-weight: normal;
			margin-top: 0.4rem;
		}
	}
}
