@import "common-var"
.cmpt-absr-review {
	.cmpt-absr-variation-header {
		.section-header {
			border-top: 0;			
		}
	}

	.section-header {
		background: gradient-greenBar-backGroundColor;
		background: gradient-greenBar;
		zoom: 1;
		border-bottom: 1px solid gradient-greenBar-borderColor;
		color: gradient-greenBar-color;
		font-weight: bold;
		padding: 9px 10px;
		position: relative;
		font-size: 14px;
		width: 100%;

		div {
			border-left: 1px solid gradient-greenBar-borderColor;
			position: absolute;
			top: 0;
			right: 0px;
			bottom: 0;
			width: 45px;
			z-index: 1;
			text-align: center;
			font-size: 26px;
		}
	}

	.element {
		width: 100%;
		padding: 10px;
		font-size: 14px;
		border-bottom: 1px solid borderColor-medium ;
		hyphenate();		

		label {
			font-weight: bold;
			width: 200px;
			display: inline-block;
		}

		span {
			display: inline-block;
		}

		&.file-section {
			.label {
				float: left;
			}

			.files {
				float: left;
				.item {
					span {
						line-height: 20px;

						&.caption {
							color: subTitle-color-dark;
							font-style: italic;
							vertical-align: text-bottom;
							margin-left: 10px;
						}
					}
				}
			}
		}

	}
}
