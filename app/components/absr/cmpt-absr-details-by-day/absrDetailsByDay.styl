.cmpt-absr-details-day{
    div.width100pc{
        width: 100%;
    }
    div.height88pc{
        height: 88%;
    }
    span.fontBold{
        font-weight: 600;
    }
    a.leftMargin10{
        margin-left: 10px;
    }
    div.fontWeightNormal{
        font-weight: normal;
    }
    div.fontBold{
        font-weight: 600;
    }
    div.rowDivider{
        border-bottom: 1px solid #e5e9ec;
        padding-top: 10px;
        padding-bottom: 20px;
    }
    div.font13{
        font-size: 13px;
    }
    div.leftPadding10{
        padding-left: 10px;
    }
    div.rightPadding10{
        padding-right: 10px;
    }
    div.font16{
        font-size: 16px;
    }
    div.leftPadding20{
        padding-left: 20px;
    }
    .verticalAlignTextTop{
        vertical-align: text-top;
    }
    div.darkFont{
        color: rgb(32, 36, 43);
    }
    div.topMargin10{
        margin-top: 10px;
    }
    div.detailsExceptDate{
        margin-left: 20px;
        border-left: 1px solid #c0c8cf;
        padding-left: 20px;
    }
    div.wordWrap{
        overflow-wrap: break-word;
        word-break: initial;
        word-wrap: break-word;
    }
    div.font15{
        font-size: 15px;
    }
    div.lightFont{
        color: rgb(65, 76, 86);
    }
    div.UnreconciledIcon{
        background: rgb(213, 219, 224);
        border-radius: 9px;
        height: 20px;
        width: 20px;
        margin-top: 2px;
    }
    div.ReconciledIcon{
        background: rgb(179, 245, 202);
        border-radius: 9px;
        height: 20px;
        width: 20px;
        margin-top: 2px;
    }
    span.UnreconciledText {
        color: rgb(32, 36, 43);
        padding-left: 5px;
    }
    span.ReconciledText {
        color: rgb(35, 135, 73);
        padding-left: 5px;
    }
    div.inServiceDayLeftBorder{
        border-left: 4px solid #deb743;
    }
    div.closedDayLeftBorder{
        border-left: 4px solid #bf2e3a;
    }
    div.closedDayLabel{
        color: #bf2e3a;
        font-size: 13px;
        height: 18px;
        text-align: right;
        float: left;
    }
    div.inServiceDayLabel{
        color: #deb743;
        font-size: 13px;
        height: 18px;
        text-align: right;
        float: left;
    }
    span.relatedAbsenceHyperlinkLabel{
        margin-left: 10px;
        vertical-align: text-top;
    }
}