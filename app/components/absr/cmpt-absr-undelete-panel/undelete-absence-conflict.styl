.textAlignContent{
    text-align: center;
    padding-left: 8px;
}

.ngdialog.ngdialog-theme-default.custom-width-conflict-700 {
        .ngdialog-content {
             width: 700px;
             top:50px;
             background: white;
        }
        .ngdialog-overlay {
            pointer-events: none;
        }
        .ngdialog-message {
            .padding {
                padding: 1rem 1rem 1rem 1rem;
                 margin: 0px 0px 0px 0px;
            }
           
            .header {
                padding: 0 0px 7px 0;
                background: none repeat scroll 0% 0% #C26B13;
            }
        }
        .ngdialog-buttons {
           border: 0;
           padding: 1rem 0rem 2rem 0rem;
        }
        
}

