.cmpt-absr-overlapping-section-symbol{
    border-radius: 12px;
    height: 23px;
    width: 20px;
    margin-top: 0.4rem;
}
div.absenceBackground{
    background-color: rgb(152, 204, 235);
}
div.inServiceDayBackground{
    background-color: rgb(231, 200, 97);
}
div.closedDayBackground{
    background-color: rgb(237, 154, 157);
}
span.symbolPadding{
    padding-left: 0.3rem;
    font-size: 0.8rem;
    font-weight: bold;
    line-height: inherit;
    vertical-align: inherit;
}