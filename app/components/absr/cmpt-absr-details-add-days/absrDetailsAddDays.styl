.cmpt-absr-details-add-days
{ 
    .cmpt-absr-error-banner{
        margin-bottom: 5px;
        height: auto;
    }

    .cmpt-ui-linking div i.chain{
        top: 1px !important;
    }
    .cmpt-ui-linking.editLink {
        height: 67px;
        top: 34px;
        left: 38px;
    }
    .cmpt-ui-dropdown select
    {
        background: linear-gradient(-180deg, rgb(255, 255, 255) 0%, rgb(241, 243, 245) 100%);
        border-radius: 2px;
        border: 1px solid rgb(192, 200, 207);
        height: 32px;
        width: 232px;   
    }
    .cmpt-ui-date-selector-v2 div.input{
        width:116px;
        input {
            width:116px;
        }
    }

    .cmpt-absr-time-field select{
        width: 108px;
    }


    .fontBold{
        font-weight: 600;
    }
    div.opacity06{
        opacity: 0.6;   
    }
    .cmpt-absr-weekdays-checkboxes input{
            background: rgb(255, 255, 255);
            border-radius: 0px;
            border: 1px solid rgb(192, 200, 207);
            box-shadow: inset 1px 1px 3px 0px rgba(0, 0, 0, 0.13);
            height: 18px;
            width: 18px;
           
    }
    .cmpt-absr-weekdays-checkboxes{
        margin-top:10px;
    }
    .topMargin10
    {
        margin-top:10px;
    }
    .marginLeft60{
        margin-left: 60px;
    }
    .marginLeft40{
        margin-left: 40px;
    }
    .marginLeft8P{
        margin-left: 8%;
    }
    .marginLeft12P{
        margin-left:12%
    }
    .marginRight24{
        margin-right: 24px;
    }
    div.wordWrap{
        overflow-wrap: break-word;
        word-break: initial;
        word-wrap: break-word;
    }
      
    .width200{
        width:200px;
    }
    .width230{
        width:230px;
    }

    .cmpt-ui-linking.breakTimeChain{
        height: 124px;
        top: 39px;
        left: 36px;
    }

    .font12{
        font-size: 12px;
    }

    .verticalAlignMiddle{
        vertical-align: middle;
    }

    .marginRight60{
        margin-right: 60px;
    }

    .deductBreakPosition{
        position: relative;
        top: 25px;
    }
    .absenceDuration{
        font-weight: 600;
        margin: 1% -15% 0% -1%;
        width: 15%;
        float: right;
    } 
    div.resetBreakTime a{
        font-weight: 600;
        margin: 1.5% -9% 0% 0%;
        width: 8%;
        float: right;
    }
    div.resetBreakTime a:hover{
      text-decoration: none;
    }  
    span.customBreakLabel{
        margin-left: -1%;
    } 

    div.schoolMultiselectDropdown {
        background-color: white;
        border-radius: 2px;
        padding: 3px;
        width: 96%;
    }
    .width98P{
        width:99%;
    }
    .empShiftTypeOverlapError{
        background: none repeat scroll 0% 0% #fbe7e6 !important;
        border-color: #e55e55 !important;
    }
    .date{
        vertical-align: -webkit-baseline-middle;
        padding-left: 0.2rem;
        font-size: 0.9rem;
    }
    .overlappingEventsDiv{
        max-height: 5rem;
        overflow-y: auto;
        overflow-x: hidden;
    }

    div.overlappingEventsDiv span.comma {
        margin-right: 0.8rem;
    }

}
