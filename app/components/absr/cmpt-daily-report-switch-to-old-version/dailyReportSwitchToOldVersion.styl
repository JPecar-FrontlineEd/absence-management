.cmpt-daily-report-switch-to-old-version {
	display: inline-block;	

	.switchButton {
		background: #f1f3f5;
		border-radius: 16px;
		border: 1px solid #d5dbe0;
		padding: 0 12px;
        line-height: 25px;

		&:focus {
			outline: none;
			box-shadow: 0 0 0 2px #414c56;
		}

		span {
			font-weight: 600;
			font-size: 12px;
		}

		i {
			color: #87939e

			&:before {
				margin-right: 0px;
			}
		}
	}
}