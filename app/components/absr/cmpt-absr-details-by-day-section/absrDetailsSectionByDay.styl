@import "common-var"
.cmpt-absr-details-section-by-day{
    div.width100pc{
        width: 100%;
    }
    div.daysFont
    {
        padding-left: 10px;
        height: 43px;
        display: inline-grid;
        font-size: 13px;
        border-bottom: 1px solid #c0c0c0;
        font-family: 'Open Sans', sans-serif;
    }
    div.closeDayHeader
    {
        background: linear-gradient(-180deg, #fbeaed 0, #e3c8cd 100%);
    }
    div.inServiceDayHeader
    {
        background: linear-gradient(-180deg, #fefbe3 0, #eeead8 100%);
    }
    div.height100pc{
        height: 100%;
    }
    span.fontBold{
        height: 16px;
        font-weight: 600;
    }
    span.font15{
        font-size: 15px;       
    }
    span.fontWeightNormal{
        font-weight:normal;
    }
    a.leftMargin10{
        margin-left: 10px;
    }
    a.margintop8{
        margin-top: 8px;
    }
    .hide{
        display:none;
    }
    div.bottompanel{
        width: 100%;
        height: 50px;
        background: rgb(245, 245, 245);
        border: 1px solid rgb(192, 200, 207);
        border-radius: 0px;
    }
    .add-days-popup{
        height: 443px;
        width: 625px;
    }
    .dialogWidthHeight{
        height: 500px;
        width: 500px;
    }

    .dialog-popup.add-absence-popup{
           .ngdialog-message {
		        .header {
			        font-weight: bold;
		        }
		        .content {
			         width:700px;
		        }
	        }
            .dialog-popup{
              width:700px;
            }
    }
   
}