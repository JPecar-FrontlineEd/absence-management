@import "common-var"
.cmpt-absr-done-next-steps {
	background:   absence-summarySection-backGroundColor;
	border-left: 1px solid gradient-blueBar-borderColor;
	padding: 10px;
	.section-heading{
		font-weight: bold;
	}

	.button-section {
		margin-top: 0.6rem;
		margin-bottom: 0.7rem;
	}

	.link {
		font-size: 14px;
	}

	.cmpt-template-worker-link{
		display: inline-block;
	}

	.log-out{
		border-top:1px solid borderColor-medium;
		margin-top: 0.6rem;
		padding-top: 0.5rem;

		a {
			font-weight: bold;
		}
	}

	.cmpt-template-approve-action {
		textarea {
			width: 100%;
			min-width: 100%;
			height: 75px;
			min-height: 75px;
			max-height: 135px;
		}

		.icon {
			display: none;
		}
	}
}
