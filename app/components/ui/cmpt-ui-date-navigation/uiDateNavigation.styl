@import "common-var"
.cmpt-ui-date-navigation {
	a {
		font-size:12px;
		float:left;
		text-align: center;
	}

	.previous {
		border-right:none;
		border-top-right-radius: 0;
		border-bottom-right-radius: 0;
	}

	.next {
		border-left:none;
		border-top-left-radius: 0;
		border-bottom-left-radius: 0;
	}

	.today {
		font-weight: bold;
		border-radius: 0;
		color: anchor-tag-blue;
		font-size: 12px;
		width: 58px;
		padding: 0;
	}
	.calendarIcon{
		font-size: 15px !important;
		margin: 4px;
		color: black;
		padding-right:8px;
		cursor: pointer;
	}
}


