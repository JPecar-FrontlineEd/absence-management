@import "common-var"
.cmpt-ui-slider {

	.plg-slider {
		border: 1px solid borderColor-medium;
	}

	.ui-slider-range {
		margin-bottom: 0;
	}

	.markers {
		position: relative;
		height: 30px;

		label {
			position: absolute;
			width: 20px;
			margin-left: -6px;
			margin-bottom: 0;
			line-height: 15px;
			margin-top: 5px;
			font-weight: 600;
		}
	}
}
