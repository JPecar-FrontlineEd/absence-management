@import "common-var"
.cmpt-ui-dropdown {
	select {
		width: 100%;
		font-size: 12px;
		background: backGroundColor;
		border: 1px solid borderColor-medium;
	}

	.label {
		overflow: ellipsis;
		font-size: 12px;
		line-height: 22px;
	}

	.error-message {
		background: none;
		color: ap-dark-red;
		font-size: 11px;
		text-align: right;
		line-height: 135%;
	}

	div.readonly {
		overflow-wrap: break-word;
		word-break: initial;
		word-wrap: break-word;
	}

	.error {
		background: none repeat scroll 0% 0% ap-light-red;
		border-color: ap-red;
		color: subTitle-color-darkest;
	}

	div {
		font-size: 14px;
	}
}
