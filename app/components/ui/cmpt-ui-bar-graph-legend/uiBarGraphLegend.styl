.cmpt-ui-bar-graph-legend {
	padding: 15px;

	.fl-hint {
		width: 100%;
		max-width: 100%;

		.title {
			font-size: 15px;
			font-weight: bold;
			line-height: 22px;
			vertical-align: middle;
			margin-bottom: 10px;
		}

		.legend-item {
			width: 50%;
			margin-bottom: 10px;
			white-space: nowrap;
			display: inline-block;
			line-height: 30px;

			span {
				display: inline-block;
				width: 30px;
				height: 30px;
				vertical-align: middle;
			}

			label {
				display: inline-block;
				vertical-align: middle;
				margin: 0 5px;
				font-size:11px;

				width:80%;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
		}
	}
}