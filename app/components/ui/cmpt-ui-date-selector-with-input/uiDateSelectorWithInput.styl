
.cmpt-ui-date-selector-with-input{
    background:white;
    border: 1px solid #bbbbbb;
    box-sizing: border-box;
    border-radius:5px;
    border-top: none;
    box-shadow: none;

    #txtDateInput{
        margin-left: 54px;
        margin-top: 8px;
        margin-bottom: 14px;
        width: 155px;
        height: 24px;
        align-content:center;
        border: 0.5px solid lightslategray;
        padding-left: 12%;
        animation:none !important;

    }
    #datepicker{
        padding:0;
        border-top: none;
    }

    .ui-datepicker-inline{
        width:263px;
    }

    .ui-datepicker .ui-datepicker-header{
        margin-top:-12px;
    }
}

.date-selector-with-input-overlay{
	background:none;
}

.date-selector-with-input-content{
    width: 298px !important;
    height: 341px;
	background: none !important;
    animation: ngdialog-flyin .3s !important;

	.header{
		display:none;
	}
}
