@import "common-var"
.cmpt-ui-rad-gauge {
	bg-color = #DDD;
	borderRadSize = 10px;

	position: relative;
	background-color: bg-color;
	border-radius: 50%;
	width: circleGaugeSize;
	height: circleGaugeSize;
	margin: 0 auto;

	.rad-container {
		height: circleGaugeSize;
		width: circleGaugeSize;
	}

	.display {
		position: absolute;
		background-color: backGroundColor;
		top: borderRadSize;
		left: borderRadSize;
		width: (circleGaugeSize - (borderRadSize * 2));
		height: (circleGaugeSize - (borderRadSize * 2));
		line-height: (circleGaugeSize - (borderRadSize * 2));
		border-radius: 50%;
		z-index: 2;
		box-shadow: 0px 0px 2px boxShadow;
		text-align: center;

		span {
			font-size: 16px;
			display: inline-block;
			vertical-align: middle;
			line-height: 16px;
			padding-bottom: 3px;
		}
	}

	.half {
		position: absolute;
		top: 1px;
		left: 1px;
		width: 0;
		border: (circleGaugeSize / 2 - 1) solid;
		border-radius: 50%;
		transition-property: transform;
		transition-timing-function: ease-in-out;
		transform: rotate(45deg);

		&.left {
			border-top-color: transparent;
			border-right-color: transparent;
			transition-delay: 0ms;
		}
		&.right {
			border-bottom-color: transparent;
			border-left-color: transparent;
		}
	}

	.show-hide {
		position: relative;
		transition: opacity 0ms;
		opacity: 0;

		&.show {
			opacity: 1;
		}
	}
	.mask {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 0;
		height: 0;
		border: (circleGaugeSize / 2) solid bg-color;
		border-top-color: transparent;
		border-right-color: transparent;
		border-radius: 50%;
		transform: rotate(45deg);
	}
}
