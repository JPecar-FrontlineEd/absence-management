@import "common-var"
.cmpt-ui-calendar-button {
	display: inline-block;
	cursor: pointer;
	float: right;
	margin-right: 14px;

	a{
		opacity: 1;
	}

	.calender-date {
		text-align: center;
		width: 70px;
		margin-bottom: 5px;

		.month {
			background: anchor-tag-blue;
			color: backGroundColor;
			padding: 2px 10px;
			border-top-left-radius: 5px;
			border-top-right-radius: 5px;
			font-size: 12px;
			font-weight: bold;
			text-transform: uppercase;

			border: 1px solid anchor-tag-blue;
			border-bottom:none;
			width:100%;
		}

		.date {
			padding: 0px 10px;
			font-size: 30px;
			font-weight: bold;
			line-height: 27px;
			border-bottom-left-radius: 5px;
			border-bottom-right-radius: 5px;
			color: subTitle-color-darkest;

			background: backGroundColor-dark;
			background-image: gradientBar;
			border: 1px solid borderColor-medium;
			.number {
				margin-top: 1px;
			}

			.daily-text {
				margin-top: 3px;
				font-size: 12px;
				line-height: 13px;
				margin-bottom: 3px;
				font-weight: bold;
			}

			&:active {
				background: backGroundColor-dark;
				background-image: gradientBar-reverse;
				border-color: borderColor-medium;
				box-shadow: inset 0 1px 1px boxShadow;
			}
		}
	}

	.date:hover {
		text-decoration: none;
	}

	.print {
		text-align: center;
		cursor: pointer;
		font-weight: bold;
		font-size: 14px;
		line-height: 14px;
	}
}
