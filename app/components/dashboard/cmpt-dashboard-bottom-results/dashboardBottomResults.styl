@import "common-var"

.cmpt-dashboard-bottom-results {
	.header {
		.header-content {
			width: content-width;
			padding: 6px 10px;
			background: dashboard-bottomResult-header-backGroundColor;
			border-top-left-radius: 5px;
			border-top-right-radius: 5px;
			line-height: 12px;
			margin-top: 15px;
			position:relative;
		}

		.count {
			padding-top: 13px;
			display: inline-block;
			background: header-count-background;
			border-radius: 50%;
			font-size: 18px;
			font-weight: bold;
			width: 40px;
			height: 40px;
			text-align: center;
		}

		.label {
			font-size: 20px;
			font-weight: bold;
			color: dashboard-bottomResult-header-text;
			margin-left: 5px;
			margin-top: 5px;
			display: inline-block;
		}

	}
	.content-panel {
		border: 4px solid content-panel-borderColor;
		border-top-width: 0;

		.no-data {

			&:before {
				content: "";
				display: block;
				width: 100%;
				height: 150px;
				background: url(../images/No-Data-Positive.png) 50% 50% no-repeat;
			}
		}

		.grid-header {
			.approval-th {
				text-align:center;
			}
			.firstShift-th {
				text-align:center;
			}
		}

		.grid-rows {
			a {
				color: anchor-tag-blue;
				text-decoration: underline;
				font-size: 12px;
				font-weight: bold;
				cursor: pointer;
			}

			.substitute-cell{
				span{
					font-size:12px;
				}
			}

			.sub-title {
				font-size: 11px;
				color: subTitle-color-light;
				margin: 5px 0;
			}

			.multi-value {
				font-size:12px;
				height:30px;
				margin-bottom: 20px;

				&:last-child {
					margin-bottom: 0px;
				}
			}

			.no-approval-required {

			}

			.not-available {
				opacity: 0.4;
			}

			.grid-row.not-available {
				opacity: 1;

				.grid-cell > * {
					opacity: 0.4;
				}
			}

			.id-cell {
				div.day-indicator {
					font-size: 11px;
					color: subTitle-color-light;
					margin: 5px 0;

					i {
						margin: 0 1px;
					}
				}
				div.dailyreportView{
					display:none;
				}
			}

			.approval-cell {
				font-weight: bold;
				padding: 10px 0;
				text-align:center;

				div.no-approval-required {
					font-size: 14px;
					color: subTitle-color-lightest;
				}

				div.approved {
					font-size: 22px;
					color: ap-green;
					a{
						color: inherit;
						font-size:inherit;
  						text-decoration: none;
					}
				}

				div.pending-approved {
					font-size: 22px;
					color: subTitle-color-lightest;
				}
			}

			.firstInstitution-cell {

			}

			.firstShift-cell {
				text-align:center;
				padding: 10px 0;

				div {
					line-height: 30px;
					margin-bottom: 5px;

					&:last-child {
						margin-bottom: 0;
					}
				}

				.duration-Icon {
					font-size: 22px;
					color: ap-blue;
				}
			}

			.created-cell {
				font-weight: bold;

				div.date {
					font-size: 12px;
					color: subTitle-color-darkest;
				}
				div.time {
					font-size: 11px;
					color: subTitle-color-dark;
				}
			}

			.held-cell {
				color: ap-red;
				font-size: 12px;
				font-weight: bold;
				vertical-align: middle;

				span {
					white-space:normal;
				}
			}

			.codes-cell {
				font-size:12px;
				line-height: 14px;

				label {
					font-weight:bold;
				}

				div {
					margin: 0 0 2px 0;
				}
			}

			// Hide the text version of the approval status
			.cmpt-template-approval .text {
				display:none;
			}
		}
	}
}
