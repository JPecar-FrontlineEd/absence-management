@import "common-var"

.cmpt-dashboard-quick-actions-panel {
	.data-spinner {
		margin: 0;
	}
	.load-error {
		color: ap-red;
	}

	.title {
		font-size: 15px;
		font-weight: 600;
		color: subTitle-color-dark;
		line-height:18px;
	}

	.search-panel {
		margin-bottom: 10px;
		border-bottom: 1px solid borderColor-light;
		padding: 10px 0;
		white-space: nowrap;

		.fl-search {
			input {
				border-radius: 3px;
				border-top-right-radius: 0px;
				border-bottom-right-radius: 0px;
				width: 210px;
				height: 30px;
				position: relative;
				top: -1px;
			}
			& > * {
				vertical-align: middle;
			}
		}

		.fl-button {
			margin-left: 0px;
			border-top-left-radius: 0px;
			border-bottom-left-radius: 0px;
			border-left: medium none;
		}

		.fl-button + span {
			margin-left: 7px;
		}

		.fl-button.fixed {
			display: none;
		}

		i {
			cursor: pointer;
			color: subTitle-color-dark;
			z-index: 1;
		}
	}
	.quick-button {
		width: 165px;
	}

	.quick-button.fl-button-lg {
		text-align: left;
		padding: 0 15px;
		margin-bottom: 5px;
	}

	.quick-button.fl-button-badge {
		text-align: left;
		padding: 7px 15px;
		line-height: 14px;
	}

	.quick-action-dropdown {
		display: none;
	}

	.fl-button-badge {
		height: 70px;
	}

	.label {
		line-height: 50px;
	}

	.badge {
		height: 24px;
		padding: 6px 3px;
		font-size: 12px;
		top: 10%;
		margin-top: 2px;
		margin-right: 14px;
		line-height: 1;
	}

	.badge-caption {
		position: absolute;
		right: 2px;
		bottom: 5px;
		font-size: 10px;
		color: subTitle-color-dark;
		font-weight: normal;
		float: right;
		width: 75px;
		text-align: center;

	}
}
