@import "common-var"
.cmpt-dashboard-banner {

	.fl-system-message{

		width: 100%;

		a {
			text-decoration:none;

			&:hover {
				text-decoration: none !important;
			}
		}

		i{
			margin-right:4px;
			vertical-align:middle;
		}
		.left-section{

			div.aesop-icon{
				background-image: url(../images/Apple_Icon_Only_60x60.png);
				width:60px;
				height:60px;
			}
		}
		.right-section{

			.fl-positive{
				color: backGroundColor;
			}
			.message{
				margin-top:5px;
				strong{
					font-weight:bold;
				}
			}
		}
		.dismiss{
			cursor:pointer;
		}

		.actions {
			border-top: 1px solid ap-light-blue;
			margin-top: 15px;
			padding-top: 15px;
		}
	}
}
