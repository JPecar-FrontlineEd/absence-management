@import "common-var"
.cmpt-reports-filter-panel {
	.filter-section {
		padding: 10px 20px 30px 20px;
	}

	.filter {
		font-size: 12px;
		height: 30px;
		white-space nowrap;
		display: inline-block;
		
		float: none;
		
		vertical-align: middle;
		-webkit-touch-callout: none;
		-webkit-user-select: none;
		-khtml-user-select: none;
		-moz-user-select: none;
		-ms-user-select: none;
		user-select: none;
	}

	input[type='checkbox'], input[type='radio'] {
		margin-right: 5px;
	}

	.title {
		font-weight: 600;
	}

	label:not(:last-child) {
		margin-right: 8px; 
	}

	label:last-child {
		margin-right: 0;
	}

	.date, .date-range {
		
		.date-picker {
			display: inline-block;
			position: relative;
			margin-top: -2px;
		}

		.title {
			font-weight: bold;
			font-size: 11px;
			position: relative;
			top: -1px;
			margin-right: 0;
		}

	}

	.cmpt-ui-quick-date-selector {
		display:inline-block;
		
	}

	.date {
		height:34px;
	}

	.stepper {
		display: none;
		padding: 0;

		.cmpt-ui-date-navigation {
			display: block;
			height: 100%;
			float: right;
		}
	}

	.month, .year {
		.date-select {
			width: 100%;
		}
	}

	.views {
		display: none;
	}

	.views-title {
		vertical-align:middle;
	}

	.views-actions {
		vertical-align: middle;
		display: inline-block;
	}

	.views-info {
		vertical-align:middle;
		font-size:14px;
		color: subTitle-color-darkest;
		cursor: pointer;
	}

	.views-actions-btn {
		padding: 0;
		height: 24px;
		border: 1px solid borderColor-medium;
	}

	.views-actions-btn.btn-list-view {
		border-radius: 4px 0px 0px 4px;
		
		&.selected {
			background: rgb(46, 122, 184);
			border: 1px solid #205586;
			box-shadow: inset 0 1px 1px boxShadow;
			cursor: default;
			color: white;
		}

		.icon {
			background-image: url('../images/global-sprite.png');
			background-repeat: no-repeat;
			background-position: -434px -221px;
			height: 20px;
			vertical-align: top;
			width: 55px;
			display:inline-block;
		}
	}

	.views-actions-btn.btn-tab-view {
		border-radius: 0px 4px 4px 0px;

		&.selected {
			background: rgb(46, 122, 184);
			border: 1px solid #205586;
			box-shadow: inset 0 1px 1px boxShadow;
			cursor: default;
			color: white;
		}

		.icon {
			background-image: url('../images/global-sprite.png');
			background-repeat: no-repeat;
			background-position: -387px -222px;
			height: 20px;
			vertical-align: top;
			width: 55px;
			display:inline-block;
		}
	}

	.preset-day-span {
		.cmpt-ui-dropdown {
			display: inline-block;
		}
		select {
			font-size: 12px;
		}
	}

	.name {
		.name-input {
			font-size: 12px;
			font-weight: normal;
			padding: 2px 8px;
		}
	}

	.preset-day-span, .name {
		.title {
			font-weight: bold;
		}
	}

	.auto-width {
		padding-right: 12px;
	}

	.school {
		span{
			width: 195px;
	    white-space: nowrap;
	    overflow: hidden;
	    text-overflow: ellipsis;
	    float: left;
		}
		.cmpt-ui-dropdown {
			float: right;
		}
	}

	.slider {
		width: 385px;
		height: 75px;

		.title {
			display: block;
			height: 27px;
		}
		.cmpt-ui-slider {
			.ui-slider {
				.ui-slider-handle {
					z-index: 1;
				}
			}
		}
	}

	.no-bg-color {
		background-color: transparent;
	}

	.disabled {
		opacity: 0.4;
		cursor: not-allowed;
		.ui-multiselect {
			cursor: not-allowed;
		}
	}

	.confirmation-number {
		display: inline-block;
		font-size: 12px;
	}

	.action-section {
		display: block;
		margin-top: 0.8rem;

		.cmpt-ui-print-button i {
			color: subTitle-color-darkest;
		}

		.reset-filters {
			float: right;

			a {
				cursor: pointer;
			}
		}
		.print-pdf{ display: none; }
	}

	.print-summary {
		.print-summary--item:nth-child(odd) {
			display: inline-block;
			width: 25%;
			font-size: 12px;
			color: subTitle-color-dark;
			border-bottom: 1px solid borderColor-medium;
			margin-bottom: 0.5rem;
			padding-bottom: 0.5rem;
			
			padding-left: 0.5rem;
		}

		.print-summary--item:nth-child(even) {
			display: inline-block;
			width: 73%;
			font-size: 12px;
			color: subTitle-color-darkest;
			border-bottom: 1px solid borderColor-medium;
			padding-left: 0.5rem;
			margin-bottom: 0.5rem;
			padding-bottom: 0.5rem;
		}
	}

	.left-column {
		padding-right: 1rem;
	}

	.right-column {
		padding-left: 1rem;
	}

	div.margins{
		margin-right: 20px;
		margin-bottom: 10px;
	}

	a.viewButtons{
		border: 1px solid #205586;
		box-shadow: 1px 2px 4px 0px rgba(46, 122, 184, 0.1);
		height: 30px;
		width: 86px;
	}

	label.font11{
		font-size: 11px;
	}

	div.padding10{
		padding: 10px;
	}

	div.collapsingArrowPadding{
		padding-left: 35%;
		padding-top: 15%;
		cursor: pointer;
	}

	div.collapsibleArrowColumn{
		border-left: 1px solid #cfcfcf;
		height: inherit;
		margin-top: -4px;
		margin-left: -1px
	}

	div.marginLeftMinus12{
		margin-left: -12px;
	}

	div.marginLeftMinus25{
		margin-left: -25px;
	}

	div.marginLeft10{
		margin-left: 10px;
	}

	span.view-action-margins, div input.nameMargins{
		margin-top: -6px; 
		margin-left: -9px;
	}

	a.marginLeftMinus4{
		margin-left: -4px;
	}

	div.selectedFiltersSection{
		margin-top: 30px;
		margin-bottom: -20px;
		border-radius: 0px 0px 4px 4px;
		border-top: 1px solid rgb(213, 219, 224);

		div.selectedFilteredValues{
			background: #fff;
			border-radius: 8px;
			margin-top: 10px;
			border: 1px solid #c0c8cf;
			height: 23px;
			display: inline-block;
			margin-right: 10px;
			line-height: 100%;

			label.selectedFilter{
				color: rgb(80, 88, 97);
				font-size: 10px;
				font-weight: 600;
				margin-left: 10px;
				margin-right: 0px;
				
				i{
					padding: 0px 4px 0px 4px;
					font-size: small;
					vertical-align: bottom;
				}
			}
		}
	}

	div.dateNavigatorMargins{
		margin-left: 5px;
	}

	div.marginRight0{
		margin-right: 0px;
	}

	div.marginRight5{
		margin-right: 5px
	}
	div.filterPanelHeader{
		margin-top: -4px;
		border-radius: 4px 4px 0px 0px;
		border-top: 1px solid #cfcfcf;
		border-bottom: 1px solid #cfcfcf;
		background-image: -webkit-linear-gradient(270deg, #fafafa 0, #e4e4e4 100%);
		background-image: -moz-linear-gradient(270deg, #fafafa 0, #e4e4e4 100%);
		background-image: -o-linear-gradient(270deg, #fafafa 0, #e4e4e4 100%);
		background-image: -ms-linear-gradient(270deg, #fafafa 0, #e4e4e4 100%);
		background-image: linear-gradient(-180deg, #fafafa 0, #e4e4e4 100%);
		height: 40px;
		font-weight: bold;
		padding: 3px 0px 3px 16px
	}
	div.filterPanelHeaderText{
		padding-top: 2px;
		font-weight: bold;
		font-size: 18px;
	}
	div.paddingTop7{
		padding-top: 7px;
	}
	div.width100pc{
		width: 100%
	}
	div.action-section-alignment{
		vertical-align: bottom;
    	position: relative;
    	top: 18px;
    	z-index: 1;
	}
}


.view-tooltip {
 	background: backGroundColor;
	padding: 10px;
	color:subTitle-color-darkest;

	.list-view {
		margin-bottom:10px;

		.icon {
			background-image: url('../images/global-sprite.png');
			background-repeat: no-repeat;
			background-position: -436px -221px;
			height: 21px;
			vertical-align: top;
			width: 55px;
			display: inline-block;
		}

		.description {
			width: 200px;
			display: inline-block;
		}
	}

	.tab-view {
		.icon {
			background-image: url('../images/global-sprite.png');
			background-repeat: no-repeat;
			background-position: -387px -222px;
			height: 21px;
			vertical-align: top;
			width: 55px;
			display: inline-block;
		}

		.description {
			width: 200px;
			display: inline-block;
		}
	}


}