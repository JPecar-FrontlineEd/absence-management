.cmpt-reports-report-writer-execdetails-dialog.dialog-popup {
	.ngdialog-message {
		.header {
			margin-bottom: 10px;
		}
		.content {
			padding: 10px 10px 20px 10px;
			font-size: 14px;
			line-height: 21px;
			.label {
				font-weight: bold;
				display: inline-block;
				margin-right: 15px;
			}
			.processing-status {
			}
			.download-results {
				margin-top: 15px;
				.title {
					font-weight: bold;
				}
				.output-files {
					margin: 12px 0 15px 0;
					padding: 0 0 0 30px;
				}
			}
			.distribution-list {
				margin-top: 10px;
			}
			.email-recipient {
				margin-top: 20px;
			}
			.ftp {
				margin: 10px 0;
				.title {
					font-weight: bold;
				}
				.info {
					margin-bottom: 0;
				}
				.label {
					font-weight: normal;
				}
			}
			.re-extracted {
				margin-top: 5px;
			}
			.loading {
				text-align: center;
				padding: 20px 0 40px 0;
			}
			.fa-spinner.fa-spin {
				font-size: 60px;
				opacity: .3;
			}
		}
	}
}



.ngdialog {
	.ngdialog-content {
		top: 160px;
	}
}