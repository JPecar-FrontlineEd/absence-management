.cmpt-reports-switcher {
	width: 100%;
	padding-bottom:1%;
	.header {
		display: inline-block;
		font-size: 1rem;
		line-height: 40px;
		color: headingColor-light;
		font-weight: 700;
		text-transform: uppercase;
	}

	.filter {
		float: right;
		display: inline-block;
		padding: 8px 10px;
		background: report-switcher-backGroundColor;
		line-height: 1;

		.label {
			font-size: 0.8rem;
			font-weight: bold;
			margin-right: 10px;
		}

		.cmpt-ui-dropdown {
			display: inline-block;

			select {
				font-size: 0.8rem;
				min-width: 200px;
			}
		}
	}
}
