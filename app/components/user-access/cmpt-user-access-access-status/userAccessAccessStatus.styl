@import "common-var.styl"

.cmpt-user-access-access-status {
	.is-processing{
		text-align: center;
	}
	span.accountStatus {
		display: inline-block;
		float: left;
	}
	span.invitationStatus {
		text-decoration: underline;
	}
	span.accountAction {
		display: inline-block;
		float: right;
	}
	i.fa-exclamation-circle	{
		color: ap-red;
		margin-right: -2px;
	}
	i.fa-circle-access-granted {
		color: ap-green;
	}
	i.fa-circle-access-paused {
		color: ap-yellow;
	}
	i.fa-circle-invited {
		color: ap-dark-grey-3;
	}
	span.accountAction {
		a {
			cursor: pointer;
		}
	}
}

div.qtipInvited {
	padding: 4px;
	div.row {
		padding-bottom: 3px;
	}
	div.qtip-label {
		color: ap-dark-grey-3;
		margin-bottom: 4px;
	}
}
