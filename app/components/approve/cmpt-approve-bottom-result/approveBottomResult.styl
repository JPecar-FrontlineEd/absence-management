@import "common-var"
.cmpt-approve-bottom-result {
	.header {
		.header-content {
			.header-buttons{
				position:absolute;
				right:10px;
				top:10px;
			}
		}

		.count {
			display: inline-block !important;
		}

	}
	.content-panel {
		 .grid-header {
			.substitute-th {
				text-align:center;
			}
			.uicheckcol-th{
				text-align:center;
			}
		}
		.grid-rows {
			font-size: 12px;
			a{
				text-decoration: underline;
				font-weight: bold;
				cursor: pointer;
			}
			.sub-title{
				font-size: 11px;
				color: subTitle-color-light;
				margin: 5px 0;
			}
			.multi-value{
				margin-bottom: 20px;
				&:last-child{
					margin-bottom: 0px;
				}
			}
			.check-cell{
				text-align:center;
			}

			.id-cell {
				.notes {
					margin-top: 5px;
					display: block;

					i {
						font-size: 16px;
					}
				}
			}

			.actions-cell{
				padding: 10px 5px;
				a{
					text-decoration:none;
					padding: 0 5px;
					margin-right: 4px;
					font-weight:normal;
					line-height:22px;
					&:last-child{
						margin-right: 0px;
					}
				}
				div{
					display: inline-block;
					margin-bottom:5px;
					white-space: pre-wrap;
				}
				.deny-part{
					color: ap-red;
				}
			}
			.startDate-cell{
				div{
					white-space: pre-wrap;
				}
			}
			.substitute-cell{
				font-weight: bold;
				padding: 10px 0;
				text-align:center;
				font-size: 22px;
				color: subTitle-color-lightest;
				span{
					font-size: 14px;
				}
				i.filled{
					color: ap-green;
				}
				i.unfilled{
					color: ap-red;
				}
			}
			.Status-cell {
				font-size: 22px;
				text-align: center;
				padding: 10px 0;

				.text {
					opacity: 0;
					cursor: default;
				}

				.partial {
					font-size: 14px;
				}
				.unapproved{
					&.icon{
						display:none;
					}
				}
				.approved{
					color: ap-green;
					a{
						color: inherit;
  						text-decoration: none;
					}
				}
				.denied{
					color: ap-red;
					a{
						color: inherit;
  						text-decoration: none;
					}
				}
				span{
					display:block;
					font-size:18px;
					text-decoration: underline;
				}
			}

			.uicheckcol-cell{
				input.hidden{
					display:none;
				}
			}
		}
		.no-absences{
			display: block;
			width: 100%;
			height: 120px;
			background: url(../images/No-Data-Positive.png) 50% 50% no-repeat;
			span{
				margin-top:150px;
				display: inline-block;
			}
		}
	}
}

.notes-content{
		div {
			label{
				font-size: 15px;
				font-weight: bold;
				color: subTitle-color-light;
				border-bottom: 1px solid borderColor-medium;
				padding-bottom: 5px;
			}
			span{
				padding: 5px 0;
				font-size: 12px;
				display:block;
				margin-top:10px;
			}
		}
}

.ngdialog.approve-dialog .ngdialog-content {
	top: -75px;
	.approval-popup {

		&.forDeny {
			.ngdialog-message {
				.header {
					color: backGroundColor;
					background: ap-red;
				}
			}
		}

		.cmpt-template-approve-action {
			.approval-status {
				.cmpt-template-approval {
					display: inline-block;

					.icon{
						display:none;
					}
				}
			}

			.approval-recieved, .approval-comments {
				margin-top: 0.8rem;
				padding-top: 0.8rem;
				border-top: 1px dashed borderColor-medium;
			}

			.approval-comments {
				> div {
					margin-top: 0.3rem;
				}
			}
			.button-section{
				display:none;
			}
		}
	}
}

.approve-all-popup {
	label {
		font-weight: 600;
	}

	label + div {
		margin-top: 0.3rem;
	}

	textarea {
		width: 100%;
		min-width: 100%;
		height: 100px;
		min-height: 100px;
		max-height: 140px;
	}

	.cmpt-ui-progress-bar {
		margin-top: 1rem;
	}

	.processing {
		text-align: center;
		height: 3rem;
		margin-top: 2rem;
	}
}
