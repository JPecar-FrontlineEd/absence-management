.cmpt-approve-filter-panel {
	.action-panel {
		.item {
			margin-right: 5px;
		}
		
		padding: 10px;
		
		div.date-picker{
			display:inline-block;
			position:relative;
			label{
				font-weight: bold;
				font-size: 12px;
				line-height: 22px;
				vertical-align: middle;
			}
		}
		div.filter{
			float:none;
			display:inline-block;
			margin-bottom:4px;
			label{
				font-size: 12px;
				line-height: 22px;
				vertical-align: middle;
				margin-right:5px;
				&.header{
					font-weight: bold;
				}
				input{
					vertical-align:middle;
					margin-right:5px;
				}
			}
			.cmpt-ui-dropdown{
				display:inline-block;
				select{
					width:200px;
				}
			}
		}
	}
	
	.action-section {
		margin-top: 0.8rem;
	}
}