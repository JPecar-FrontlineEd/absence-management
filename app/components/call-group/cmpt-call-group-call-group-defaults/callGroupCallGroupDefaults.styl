@import "common-var"
.cmpt-call-group-call-group-defaults {
	padding: 16px 15px;
	background: absence-summarySection-backGroundColor;
	border-bottom: 1px solid borderColor-medium;

	.no-edit {
		opacity: 0.5;
	}

	.group-title {
		font-size: 15px;
		font-weight: 700;
		line-height: 3rem;
	}

	.title {
		margin-bottom: 0;
		margin-top: 0;
		text-transform: uppercase;
	}

	.calling-sequence-container {
		.calling-sequence-radio {
			margin-bottom: 0px;
			font-size:14px;
			input{
				margin-right:2px;
			}
		}
	}
	.job-visibility-container {
		border-left: 1px solid borderColor-medium;
		padding-left: 15px;

		.title {
			margin-bottom: 10px;
		}

		.visibility-percent {
			font-size:14px;
		}

		input {
			width: 52px;
		}

		.cmpt-ui-textbox {
			width:48px;
			display:inline-block;
		}

		.fl-button {
			margin-top: 12px;
		}

		.job-visibility-row {
			margin-bottom: 10px;
			font-size:14px;
		}

		label {
			font-weight: bold;
			display: inline-block;
			width: 40px;
			vertical-align: middle;
		}

		.label {
			display: inline-block;
  			width: 40px;
  			vertical-align: middle;
  			margin-left: 5px;
		}

	}
	.button-container {
		border-left: 1px solid borderColor-medium;
		padding-left: 15px;
	}
	.button-container{
		i{
			margin-right:5px;
			display:inline-block;
		}
	}
	.fl-system-message{
		&.error{
			div{
				span{
					margin-right:2px;
				}
			}
			ul{
				list-style:initial;
				margin-left:35px;
			}
		}
	}
}
