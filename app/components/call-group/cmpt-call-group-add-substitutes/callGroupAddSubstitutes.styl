@import "common-var"
.cmpt-call-group-add-substitutes {
	.header {
		position: relative;
		.search-by-text {
			background: gradient-greenBar-backGroundColor;
			background-image: gradient-greenBar;
			border-bottom: 1px solid gradient-greenBar-borderColor;
			color: gradient-greenBar-color;
			padding: 10px;
			min-height: 50px;
			span {
				font-size: 12px;
				font-weight: bold;
				margin-right: 5px;
			}
			input {
				width: 300px;
			}
		}
		.actions {
			position: absolute;
			top: 10px;
			right: 5px;
		}
	}

	.sub-sections {
		min-height: 320px;
		background: backGroundColor;
		position: relative;

		.search-by-letter{
			display: table-cell;
  			vertical-align: top;
			width: 250px;
			background: backGroundColor-dark;

			.letter-header {
				background: gradientBar;
				border-bottom: 1px solid grid-borderColor;
				padding: 10px;
				font-weight: bold;
				color: subTitle-color-darkest;
				font-size: 12px;
			}

			.letter-table {
				width: 88%;
				height: 100%;
				margin: 0 auto;
				padding-top: 15px;
				div {
					width: 35px;
					height: 35px;
					cursor: pointer;
					color: subTitle-color-light;
					background: none repeat scroll 0% 0% backGroundColor;
					margin: 4px;
					text-align: center;
					display: inline-block;
					font-size: 15px;
					border-radius: 50px;
					box-shadow: 1px 1px boxShadow;
					line-height: 43px;
					border: 1px solid borderColor-light;
					padding-left: 1px;
					&:hover {
						opacity: 1;
						color: subTitle-color-dark;
						box-shadow: 2px 2px 1px boxShadow;
					}
					&:active {
						box-shadow: 1px 1px boxShadow inset;
						color: subTitle-color-lightest;
					}
					span {
						position: relative;
						top: -6px;
					}
				}
			}
		}

		.search-results {
			display: table-cell;
			width: 380px;
			background: backGroundColor;
			min-height: 325px;
			border: 1px solid grid-borderColor;
			border-bottom: 0;
			border-top-width: 0;

			&.rating-hidden {
				.row-item {
					.checkbox {
						top: 13px;
					}

					.cmpt-template-substitute-link {
						margin-bottom: 0;
					}
				}
			}

			.load-more {
				padding: 10px 0;
				text-align:center;
			}

			.no-data {
				text-align: center;
				font-size: 16px;
				font-weight: bold;
				color: subTitle-color-light;
				padding-top: 10px;
			}
		}

		.selected-subs {
			display: table-cell;
  			vertical-align: top;
  			position: relative;
  			height: 100%;
			background-color: absence-summarySection-backGroundColor ;
			width: 360px;
			min-height: 310px;

			.header {
				background: gradient-lightBlueBar-backGroundColor;
				background: gradient-lightBlueBar;
				border-bottom: 1px solid gradient-lightBlueBar-borderColor;
				color: gradient-lightBlueBar-color;
				border-top: none;
				font-size: 12px;
				font-weight: bold;
				text-transform: uppercase;
				padding: 10px;
			}

			.selected-sub-list {
				padding: 10px;

				.no-subs-selected {
					font-size: 12px;
					text-align: center;
					margin-top: 0.5rem;
				}

				.selected-sub {
					position: relative;
					padding: 5px 40px 10px 5px;
					font-size: 12px;
					border-bottom: 1px solid grid-borderColor;

					&:first-child {
						border-top: 1px solid grid-borderColor;
					}

					.sub-name {
						font-weight: bold;
						width: 89%;
						overflow: hidden;
						text-overflow: ellipsis;
					}

					.no-rating {
						line-height: 12px;
						font-size: 10px;
  						font-weight: normal;
  						height: 12px;
					}

					.remove-sub {
						position: absolute;
						top: 10px;
						right: 5px;
					}

					&.rating-hidden {
						padding-top: 8px;

						.remove-sub {
							top: 7px;
						}
					}
				}
			}
		}
	}
	.footer {
		clear: both;
		width: 100%;
		height: 50px;
		position: relative;
		background: greyBar-backGroundColor;
  		border-top: 1px solid borderColor-medium;
  		padding: 10px 12px;
		.actions {
			position: absolute;
			top: 10px;
			right: 5px;
		}
	}
}
