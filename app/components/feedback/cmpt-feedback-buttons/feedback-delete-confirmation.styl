@import "common-var"
.dialog-popup.modal-feedback-delete-confirmation {
	.ngdialog-message {
		.header {
			background: ap-red;
			color: ap-light-grey-4;
		}
		.content {
			font-size: 14px;
			.message {
				border-bottom: 1px solid borderColor-medium;
				margin-bottom: 15px;
				padding-bottom: 15px;
				line-height: 1.25em;
				font-weight: bold;
			}
			.cmpt-template-approval {
				display: inline-block;
				font-weight: normal;
				.icon {
					display: none;
				}
			}
		}
	}
}
