@import "common-var"
.cmpt-feedback-buttons {
	a{
		margin:0 5px;
		&.right{
			float:right;
		}
		&.green-color{
			color: ap-green;
		}
		&:first-child{
			margin-left:0;
		}
		&:last-child{
			margin-right:0;
		}
	}
	.feedback-error{
		margin-left: 5px;
		font-size: 14px;
		font-weight: 600;
		color: ap-dark-red;
	}
}
