@import "common-var"
.cmpt-nav-sub-menu {
	position: absolute;
	width: sidebar-width;
	left: 100%;
	top: 0;
	height: "calc(100vh - %s)" % topbar-height;

	&.sub-level-1 {
		top: -(sidenav-title-height);
	}

	.fa {
		color: sidenav-text;
	}

	.no-mega {
		margin-left: 20px;
		margin-right: 20px;

		.shortcut-key{
			font-size: 8px;
			font-weight: 800;
			color: lighten(sidenav-text, 50%);
			border: 1px solid sidnav-shortKeyBorderColor;
			padding: 1px 2px 2px 2px;
			position: relative;
			top: -1px;

			&:empty {
				display: none;
			}
		}

	}

	& > div > ul {
		display: block;
		width: 100%;
		padding-bottom: 6px;

		&:first-child {
			padding-top: 15px;
		}

		&.menu-group {
			overflow-x: hidden;
			white-space: normal;
			font-size: 0;
		}

		& > li {
			&.sub-menu-item {
				display: block;
				font-size: 12px;
				width: sidebar-width - 20;
				margin: 0;
				cursor: default;
				color: lighten(sidenav-text, 15%);

				.sub-menu-item-container {
					position: relative;
					padding: 5px 10px;
					overflow: hidden;
					white-space: nowrap;
					text-overflow: ellipsis;
					font-weight:600;
				}

				&.highlight {
					background-color: nav-highlight;
					color: nav-highLightColor;

					.fa.more-items {
						color: nav-highLightColor;
					}
				}

				&.menu-action {
					cursor: pointer;
					width: auto;

					.fa.more-items {
						display: none;
					}
				}

				.more-items {
					position: absolute;
					display: inline-block;
					color: sidenav-text;
					right: 25px;
					transform: translateX(0);
					transition: transform 100ms;
				}

				&:hover {
					color: sidenav-text;
					background-color: sidenav-bg;

					.fa.more-items {
						color: sidenav-text;
						transform: translateX(8px);
					}
				}
			}

			&.group-title {
				position: relative;
				font-weight: 400;
				font-size: 15px;
				margin: 7px 0;
				margin-top: 3px;
				margin-bottom: 4px;
				padding: 2px 10px;
				color: darken(sidenav-text, 5%);
				margin-left: -20px;
				margin-right: -20px;

				.text {

					position: relative;
					z-index: 3;
					padding-left: 7px;
					padding-right: 7px;
					margin-left: 13px;
				}

				.line {
					background: sidenav-groupTitle-lineColor;
					height: 1px;
					width: 100%;
					position: absolute;
					top: 16px;
					left: 0;
					z-index: 2;
				}
			}
		}
	}

	.mega-menu {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		overflow: auto;

		.menu-group {
			padding-left: 20px;
			padding-right: 20px;
		}

		li.sub-menu-item {
			display: inline-block;
			width: sidebar-width - 10;
			margin: 0 0 0 10px;
		}

		.menu-action {
			margin-right: 0 !important;
			margin-left: 0 !important;
		}
	}

	deepestLevel = 3;

	for level in (1..deepestLevel) {
		&.sub-level-{level} {
			background-color: lighten(sidenav-bg, level * color-adjust-amt);
			& > div > ul > li.sub-menu-item:hover {
				background-color: lighten(sidenav-bg, (level+1) * color-adjust-amt);
			}
			.group-title{
				.text{
					background: lighten(sidenav-bg, level * color-adjust-amt);
				}
			}

		}
	}

	&.sub-level-{deepestLevel - 1} {
		.no-mega {
			position: absolute;
			top: 0;
			right: 0;
			bottom: 0;
			left: 0;
			overflow-y: auto;
			overflow-x: hidden;
		}
	}
}
