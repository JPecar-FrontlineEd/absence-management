.cmpt-context-menu{
    li:hover{
        background: #B8E1FF;
    }

    ul.contextMenuBackground{
        background-color: white; 
        padding: 5px;
        font-size: 12px;
        border: 1px solid #C0C8CF;
    }

    label.contextMenuHeader{
        text-align: center; 
        border-bottom: 1px solid #cfcfcf;
        font-size: 12px;
        padding-bottom: 5px;
        display: block;
        font-weight: bold;
    }

    li.padding2{
        padding: 2px;
        
        a.link{
            display: block;
            height: inherit;
            width: inherit;
            padding: inherit;
            text-decoration: none;
            color: #2F353F
        }
    }
}