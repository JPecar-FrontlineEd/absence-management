@import "common-var"
.cmpt-template-approve-action {
	padding: 10px;
	border: 1px solid approvalAction-borderColor;
	border-radius: 5px;
	box-shadow: 0px 0px 3px boxShadow-dark inset;
	background: approvalAction-backGroundColor;
	margin-top: 1.5rem;
	margin-bottom: 0.5rem;
	font-size: 13px;


	&:before {
		content: "";
		display: block;
		border-top: 1px dashed borderColor-light;
		position: relative;
		top: -23px;
		margin-left: -10px;
		margin-right: -10px;
	}

	&.no-bg {
		border: none;
		background: none;
		box-shadow: none;
		margin: 0;
		padding: 0;

		&:before {
			display: none;
		}
	}

	textarea {
		width: 100%;
		min-width: 100%;
		height: 100px;
		min-height: 100px;
		max-height: 140px;
	}

	.header {
		display: none;
	}

	label {
		margin-right: 5px;
		font-weight: 600;
	}

	.approved {
		color: ap-green;
	}

	.unapproved {
		color: ap-yellow;
	}

	.denied {
		color: ap-red;
	}
	.partial{
		color: ap-yellow;
	}

	.button-section {
		text-align: right;
	}

	.approval-status {
		.cmpt-template-approval {
			display: inline-block;
		}
	}

	.approval-comments, .approval-recieved {
		margin-top: 0.5rem;
	}
	.approval-action{
		span{
			font-size: 12px;
		}
	}
	.previous-comments {
		span {
			font-weight: bold;
		}
		.comments{
			font-size: 12px;
		}
	}

	.processing {
		font-size: 12px;
		font-weight: bold;

		i {
			font-size: 14px;
		}
	}

}
