@import "common-var"
.cmpt-current-step {
	clearfix();
	.left-section{
		float:left;
		div.label{
			vertical-align: middle;
			font-size: 13px;
			margin-right: 10px;
			display: inline-block;
			color: absence-currentStep-color;
			float:left;
			line-height:30px;
		}
		span{
			float:left;
		}
	}
	.right-section{
		float:right;
		div.label{
			font-size: 12px;
			font-weight: bold;
			margin-right: 5px;
			color: absence-currentStep-color;
			display: inline-block;
		}
	}
	.labelViewBy{
		float: left;
		font-family: inherit;
		font-size: 12px;
		margin-right: 5px;
		margin-top: 5px;
	}
	.switchButtonMargins{
		margin-right: 144px !important;
		margin-left: -1px !important;
	}
	.activeSwitchButton{
		background-color: #2E7AB8;
		background-image: none;
		color: #ffffff;
		border-color: #2E7AB8;
		background-color: #2E7AB8;
		background-repeat: repeat-x;
	}
	.marginRight250{
		margin-right: 250px;
	}
	.fontBold{
		font-weight: 600;
	}
	.left{
		float: left;
	}
}
