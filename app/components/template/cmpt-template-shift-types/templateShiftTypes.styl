@import "common-var"
.cmpt-template-shift-types {
	text-align:center;

	.icon-container {
		height: 100%;
		overflow: visible;
	}

	.duration-Icon {
		font-size: 22px;
		color: ap-blue;
		cursor: default;
	}

	.FullDay:before {
		content: '\e614';
	}

	.HalfDayAM:before {
		content: '\e60e';
	}

	.HalfDayPM:before {
		content:'\e613';
	}

	.CustomDay:before {
		content: '\e610';
	}
	
	.wrap-words{
		white-space:normal;
	}
}
