@import "common-var"
.cmpt-template-variation-extensions-tooltip {
	max-height: 300px;
	overflow: auto;

	table {
		color: black;
		thead {
			th {
				padding: 5px;
			}
		}
		tbody {
			td {
				vertical-align: top;
				padding: 5px;

				span.extensionId {
					color: green;
					font-weight: bold;
				}

				span.confNum {
					color: black;
				}
			}
		}
	}
}