@import "common-var"
.route-settings-school-details {
	.heading {
		display: inline-block;
		font-size: 1rem;
		line-height: 40px;
		color: headingColor-light;
		font-weight: 700;
		text-transform: uppercase;
	}

	.school-selector {
		float: right;
		display: inline-block;
		padding: 8px 10px;
		background: report-switcher-backGroundColor;
		line-height: 1;

		.label {
			font-size: 0.8rem;
			font-weight: bold;
			margin-right: 10px;
		}

		.cmpt-ui-dropdown {
			display: inline-block;
		}
	}

	h3 {
		margin-top: 0.5rem;
	}

	.cmpt-ui-tabs {
		.tabs {
			a {
				width: 175px;
			}
		}
	}
}
