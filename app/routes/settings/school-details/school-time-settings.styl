@import "common-var"
.route-settings-school-details-school-time-settings {
	.header {
		background: gradient-blueBar-backGroundColor;
		background: gradient-blueBar;
	  border-bottom: 1px solid gradient-blueBar-borderColor;
		color: gradient-blueBar-color;
		padding: 20px;
		font-weight: bold;
	}
	.container {
		min-height: 200px;
		.content {
			background: backGroundColor;
			font-size: 14px;
			.info-header {
				backGroundColor: gradient-greenBar-backGroundColor;
				background: gradient-greenBar;
				border-top: 1px solid gradient-greenBar-borderColor;
				border-bottom: 1px solid gradient-greenBar-borderColor;
				color:gradient-greenBar-color;
				width: 100%;
				line-height: 21px;
				padding: 10px 0px;
				span {
					font-size: 14px;
					font-weight: bold;
					margin: 4px 20px;
				}
			}
			.info-row {
				div {
					padding: 10px 0 10px 5px;
					display: inline-block;
					width: 50%;
				}
				.label {
					display: inline-block;
					width: 40%;
					font-weight: bold;
					text-align: right;
				}
			}
		}
	}
}
