@import "common-var"
.route-settings-school-details-school-shared-files {
	.title {
		margin-right: 10px;
		font-weight: bold;
		text-align: right;
	}

	.description {
		margin-right: 10px;
		font-size: 12px;
		text-align: right;
	}

	.actions-header {
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		padding: 10px 12px;
		width: 100%;
		border-bottom: 1px solid borderColor-medium;

		.count {
			margin-left: 5px;
			font-weight: bold;
		}
	}

	.no-data {
		text-align:center;
		padding-top: 2rem;
		padding-bottom: 2rem;

		.image {
			  background: url(../images/No-Data-Initial.png);
			  background-repeat: no-repeat;
			  width: 150px;
			  height: 135px;
			  display: inline-block;
			  background-position-x: 50%;
		}

		.caption {
			font-size: 14px;
		  	color: subTitle-color-light;
		  	font-weight: bold;
		  	text-align: center;
		}
	}

	.data-section {
		position: relative;
	}

	.action {
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		padding: 10px 12px;
		text-align: right;
	}

	.grid-row {
		.file-cell {
			font-size: 14px;
			line-height: 2;
			overflow: hidden;
			text-overflow: ellipsis;
		}
	}
}
