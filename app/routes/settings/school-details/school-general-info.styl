@import "common-var"
.route-settings-school-details-school-general-info {
	.header {
		background: gradient-blueBar-backGroundColor;
		background-image: gradient-blueBar;
	  border-bottom: 1px solid gradient-blueBar-borderColor;
		color: gradient-blueBar-color;
		padding: 20px;
		font-weight: bold;
	}

	.container {
		min-height: 200px;

		.content {
			padding: 0 0 0 10px;
			background: backGroundColor;
			font-size: 14px;

			.info-row {
				div {
					padding: 10px 0 10px 5px;
					display: inline-block;
					width: 50%;

					.label {
						display: inline-block;
						width: 30%;
						font-weight: bold;
						text-align: right;
					}
				}
			}
		}
	}

	.get-directions-container {
		padding: 15px;
	}

	.get-directions {
		margin-left: 125px;
	}
}
