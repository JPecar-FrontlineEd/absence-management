@import "common-var"
.route-settings-school-details-school-excluded-substitutes {
	.clear:before, .clear:after {
		content: "";
		display: table;
	}

	.clear:after {
		clear: both;
	}

	.left-section {
		float: left;
	}

	.right-section {
		float: right;
	}

	.actions-footer, .actions-header {
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		padding: 10px 12px;
		text-align: right;
		width: 100%;
		height: 50px;
	}

	.actions-header {
		border-bottom: 1px solid borderColor-medium;
	}
}
