@import "common-var"
.route-settings-school-details-school-preferred-substitutes {
	.clear:before, .clear:after {
		content: "";
		display: table;
	}

	.clear:after {
		clear: both;
	}

	.left-section {
		float: left;
	}

	.right-section {
		float: right;
	}

	.actions-footer, .actions-header {
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		padding: 10px 12px;
		text-align: right;
		width: 100%;
		height: 50px;
	}

	.actions-header {
		border-bottom: 1px solid borderColor-medium;
	}

	.fl-button-sm{
		text-decoration:none;
	}

	.icon-loading {
		background-image: url(/Content/images/loader-sm.gif);
		background-repeat: no-repeat;
		height: 16px;
		display: inline-block;
		margin-right: 7px;
		vertical-align: middle;
		width: 16px;
	}
	.sv-helper{
		border-top: 1px solid borderColor-medium;
	}


}
