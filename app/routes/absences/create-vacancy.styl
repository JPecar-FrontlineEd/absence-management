@import "common-var"

.route-absences-create-vacancy {
	.title {
		float:left;

		h5 {
			color: headingColor-dark;
			line-height: 30px;
		}
	}

	div.top {
		background: gradient-blueBar-backGroundColor;
		background: gradient-blueBar;
		border-bottom: 1px solid gradient-blueBar-borderColor;
		color: gradient-blueBar-color;
		padding: 10px;
		width: 100%;

		.left-section {
			span.button-section {
				display: none;
			}
		}
	}

	div.bottom {
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		border-top: 1px solid borderColor-medium;
		padding: 10px 12px;
		text-align: right;
		width: 100%;

		.left-section {
			span.button-section {
				display: none;
			}
		}
	}

	.body-section {
		background: backGroundColor-dark;
	}

	.search-by-letter {
		border-right: 1px solid borderColor-medium;
	}

	.cmpt-absr-switch-to-old-version {
		margin-top: 17px;
		margin-left: 10px;
	}
}
