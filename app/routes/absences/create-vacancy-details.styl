@import "common-var"
.route-absences-create-vacancy-details {
	.title{
		float:left;
		h5{
			line-height:30px;
			font-weight: bold;
		}
	}

	div.top{
		background: gradient-blueBar-backGroundColor;
		background: gradient-blueBar;
		border-bottom: 1px solid gradient-blueBar-borderColor;
		color: gradient-blueBar-color;
		padding: 10px;
		width:100%;
		.left-section{
			span.button-section{
				display:none;
			}
		}
	}
	div.bottom{
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		border-top: 1px solid borderColor-medium;
		padding: 10px 12px;
		text-align: right;
		width:100%;
		div.label{
			font-weight:bold;
		}
	}
	.bold{
		font-weight:bold;
	}

	.cmpt-template-worker-link {
		display: inline-block
		font-size: inherit;
	}
	.hide{
		display: none;
	}
}
