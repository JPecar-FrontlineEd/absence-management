@import "common-var"

.route-create-absence-review {
	.label-green{
		color: ap-green;
		margin-right:5px;
	}
	.title{
		float:left;
		h5{
			line-height:30px;
			font-weight: bold;
		}
	}
	.content-panel {
		border: 5px solid content-panel-borderColor;
		padding: 0;
		background: backGroundColor;
		width: 100%;
		clear: both;
		div.top{
			background: gradient-blueBar-backGroundColor;
			background: gradient-blueBar;
			border-bottom: 1px solid gradient-blueBar-borderColor;
			color: gradient-blueBar-color;
			padding: 10px;
			width:100%;
			.left-section{
				span.button-section{
					display:none;
				}
			}
		}
		div.bottom{
			background: greyBar-backGroundColor;
			color: subTitle-color-darkest;
			border-top: 1px solid borderColor-medium;
			padding: 10px 12px;
			text-align: right;
			width:100%;
			div.label{
				font-weight:bold;
			}
		}
		.bold{
			font-weight:bold;
		}
	}

	.cmpt-template-worker-link {
		display: inline-block;
		margin-left: 4px;
		font-weight: bold;
	}
	span.fontBold{
        font-weight: 600;
    }
}
