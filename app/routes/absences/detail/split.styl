.route-absences-detail-split {
	font-size: 14px;
	.splitAtOptions{
		display: flex;
		label{
			margin-right:12px;
			font-weight: 600;
		}
	}
	.splitIntoOptions{
		display: flex;
		margin-left:12px;
		width: 100%;
		label{
			display: flex;
			align-items: center;
			gap: 4px;
			margin-right:12px;
			font-weight: 600;
			font-size: 12px;
		}
	}
	.section-heading{
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.top, .bottom {

		.label {
			float: left;
			font-size: 16px;
		}

		#removeSub {
			margin-left: 8px;
			vertical-align: middle;
		}

		a {
			margin-left: 5px;
		}
	}
	.cmpt-template-shift-types {
		height: 25px;
	}
	.shiftTypeData-cell {
		padding: 5px;
	}
	.fa-spinner {
		position: relative;
		left: -6px;
	}
}
