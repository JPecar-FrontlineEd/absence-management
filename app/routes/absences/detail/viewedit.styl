@import "common-var"
.route-absences-detail-view-edit {
	position: relative;
	.view-edit-processing{
		spinnerMargin = 150px;
		.processing{
			position: absolute;
			top: 0;
			width: 100%;
			height: 100%;
			background: backGroundColor;
			z-index: 2;
			opacity: 0.8;
		}
		.logo-spinner{
			margin: spinnerMargin auto;
			.bar{
				background-color: rgba(255,255,255,.65);
				animation-name: height-change-blue;
			}
		}
		.text{
			font-weight:bold;
			font-size:12px;
			color: ap-blue;
			position:absolute;
			z-index: 2;
			margin: spinnerMargin - 30px auto;
			width: 100%;
  			text-align: center;
  			text-transform: uppercase;
		}
	}
	div.top{
		background: gradient-blueBar-backGroundColor;
		background: gradient-blueBar;
		border-bottom: 1px solid gradient-blueBar-borderColor;
		color: gradient-blueBar-color;
		padding: 10px;
		width:100%;
		height:51px;
	}
	div.bottom{
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		border-top: 1px solid borderColor-medium;
		padding: 10px 12px;
		width:100%;
		height:51px;
	}
	form.hide{
		display: none;
	}
	.cmpt-absr-details-summary-section{
		border-left:0;
	}
	.right-side{
		border-left: 1px solid borderColor-medium;
		background: absence-summarySection-backGroundColor;
		.fl-button-sm{
			padding: 0 6px;
			i{
				margin-right:3px;
			}
		}
		.summary{
			.summary-details{
				background: backGroundColor;
				border-bottom:0;
				.need-sub {
					div {
						float: right;
						.label {
							font-weight: bold;
							font-size: 16px;
							top: 0;
							right: 35px;
						}
					}
				}
				.mark-long-term {
					div {
						float: right;
						}
				 }
				.gross-payout{
					line-height:10px;
					label{
						vertical-align:super;
						font-weight:500;
						font-size:14px;
						line-height:30px;
						padding-bottom:0;
						margin-right:10px;
					}
					div{
						display: inline-block;
						text-align: right;
						font-weight:bold;
						.label{
							padding: 0;
							font-size: 16px;
							width: 55px;
						}
					}
				}
			}
			.summary-footer{
				background-image: url(../images/receipt-edge.png);
				height: 7px;
				width: 100%;
				background-repeat: repeat-x;
				float: left;
			}
		}
	}
}
.deletedAbsrNextPanelBackground{
	background: #f5f5f5;
}
