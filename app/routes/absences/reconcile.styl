@import "common-var"
.route-absences-reconcile {
	.hint{
		font-size:12px;
		margin-top:10px;
		margin-bottom:10px;
	}
	.fl-hint{
		max-width:1000px;
	}

	.fa-angle-left, .fa-angle-right {
		font-size: 20px;
		display: inline-block;
		transform: rotate(0deg)
		transform-origin: 40% 55%;
		transition: transform 200ms;
		line-height: 0px;
	}

	.toggle-handle {
		padding: 8px;
	}

	.week {
		.grid-header-content {
			opacity: 0.6;

			&:last-child {
				opacity: 1;
			}
		}

		&.expanded {
			.grid-header-content {
				opacity: 1;
			}

			.fa-angle-left, .fa-angle-right {
				transform: rotate(90deg);
			}
		}

		.top-padding {
			font-size: 14px;
			line-height: 28px;

			&:first-child {
				padding-left: 1.5rem;
			}
		}
	}

	.btn-reconcile {
		width: 140px;
	}
	.lnk-reconcile {
		cursor: pointer;
	}

	.day-no-items {
		color: subTitle-color-lightest;
		font-size: 14px;
  		line-height: 28px;
	}

	.badge {
		background: header-count-background;
		width: auto;
		display: inline-block;
		position: relative;
		top: -1px;
		border-radius: 25px;
		padding-left: 6px;
		padding-right: 5px;
		padding-top: 3px;
		padding-bottom: 3px;
		vertical-align: middle;
		font-size: 12px;
		line-height: 1;
		box-shadow: inset 1px 1px 1px boxShadow;
		border: 1px solid borderColor-medium;
		margin-left: 2px;
	}

	.progress-bar {
		width: 100%;
		border: 1px solid borderColor-medium;
		height: 20px;
		background-color: backGroundColor;
		overflow: hidden;

		.progress-fill {
			height: 100%;
			width: 100%;
			transition: transform 800ms ease-out;
			transform: translateX(-100%);
		}
	}

	.filter.schools .dropdown {
		right: 0;
	}

	.content-panel {
		min-height: 300px;
		.grid-cell {
			padding: 10px;
		}
		.footer {
			span {
				background: greyBar-backGroundColor;
  				font-weight: bold;
  				border-top: 2px solid borderColor-medium;
  				border-left: 1px solid grid-borderColor;
			}
		}
	}
}
