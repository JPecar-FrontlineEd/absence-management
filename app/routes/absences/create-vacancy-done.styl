@import "common-var"

.route-absences-create-vacancy-done {
	.title{
		float:left;
		h5{
			line-height:30px;
			font-weight: bold;
		}
	}
	.cmpt-absr-top-section-summary{
		margin-top:0;
		.top-details{
			display:none;
		}
		#related-closed-days{
			margin-top:0;
		}
	}
	.cmpt-template-confirmation-link {
		display: inline-block;
		padding-left: 5px;
	}
	.content-panel {
		border: 5px solid content-panel-borderColor;
		padding: 0;
		background: backGroundColor;
		width: 100%;
		clear: both;
		div.top{
			background: gradient-blueBar-backGroundColor;
			background: gradient-blueBar
			border-bottom: 1px solid gradient-blueBar-borderColor;
			color: gradient-blueBar-color;
			padding: 10px;
			width:100%;
			.left-section{
				span.button-section{
					display:none;
				}
			}
		}
		div.bottom{
			background: greyBar-backGroundColor;
			color: subTitle-color-darkest;
			border-top: 1px solid borderColor-medium;
			padding: 10px 12px;
			text-align: right;
			width:100%;
			div.label{
				font-weight:bold;
			}
		}
		.bold{
			font-weight:bold;
		}
	}
}
