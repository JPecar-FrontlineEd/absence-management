@import "common-var"
.route-access {
	.authenticated {
		color: fl-green;
	}
	.unauthenticated {
		color: fl-red;
	}
	.redirect {
		cursor: pointer;
	}
	.redirecting{
		opacity:0.4;
	}
}
.mos-created-dialog {
    z-index: 999999999999999;
        .dialogMain {
            width: 530px;
            height: 395px;
            border-radius: 5px 5px 5px 5px;
            background-color: #e8ecf0;
            font-family: 'Open Sans', Arial, Helvetica, sans-serif;
        }
        
        .uppercontainer {
            background-color: white;
            width: 100%;
            height: 275px;
            margin: 0 0 0 0 !important;            
        }
      
        .mosCreatedHeader {
            box-sizing:border-box;
            width: 100%;
            height: 50px;
            border-radius: 4px 4px 0 0;
            background-color: #213d7e;
            margin: 0 !important;
            padding-bottom: 10px !important;
        }
        
        .success {
            width: 38.5px;
            height: 13.5px;
            font-size: 24px;
            font-weight: bold;
            font-style: normal;
            font-stretch: normal;
            color: #ffffff;
            padding-top: 12px;
            padding-bottom: 12px;
            padding-left: 21px;
        }
        
        .notification {
            box-sizing: border-box;
            width: 100%;
            height: 60px;
            font-size: 17px;
            font-weight: normal;
            font-style: normal;
            font-stretch: normal;
            color: #4a4a4a;
            padding-top: 20px;
            padding-left: 20px;
            padding-bottom: 20px;
            padding-right: 25px;
        }
        
        .separator { 
            width: 90%; 
            height: 1px; 
            background-color: #d8d8d8;
            margin-top: 20px;
            margin-left: 20px;
        }
      
        .separator2 { 
            width: 90%; 
            height: 1px; 
            background-color: #d8d8d8;
            margin-top: 14px;
            margin-left: 20px;
        }
      
        .mosInfo {
            margin-left: 20px;
            margin-top: 18px;
        }
      
        table {
            border-collapse: collapse;
        }

        td {
            padding-bottom: 8px;
        }
      
        .titleText {
            font-size: 14px;
            font-weight: bold;
            
        }
      
        .infoText {
            font-size: 24px;
            font-weight: bold;
            padding-left: 45px;

        }
      
        .linkText {
            font-size: 14px;
            padding-left: 10px;
        }
      
        .disclaimer {
            margin-top: 10px;
            margin-bottom: 5px;
            margin-left: 20px;
            font-size: 14px;
            font-weight: bold;
        }  
        
        .changePinInfo {
            font-size: 11px;
            font-weight: normal;
        }
        
        .content {
			font-size: 14px;
			ul {
				margin-top: 10px;
			}
			li {
				font-weight: bold;
			}
		}
    
}

