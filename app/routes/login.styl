.route-login {
	margin: 0px auto;
	position: relative;
	height: 100%;
	width: 275px;

	form {
		padding: 30px;
		border-radius: 10px;
		background-color: white;
		box-shadow: 1px 2px 2px rgba(0, 0, 0, 0.15);
		width: 25%;
		top: 200px;
		height: 225px;

		h3 {
			margin-top: 0;
		}

		input {
			margin-top: 10px;
			width: 100%;

			&:first-child {
				margin-top: 0;
			}
		}

		button {
			float: right;
			margin-top: 10px;
		}
	}
}
