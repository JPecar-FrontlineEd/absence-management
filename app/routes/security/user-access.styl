@import "common-var.styl";
.route-security-user-access {
	.qtip-on-click-cursor {
		cursor: pointer;
	}
	.qtip-on-click-cursor i.fa:before {
		margin-right: 1px;
	}

	font-size: 12px;
	a {
		text-decoration: underline;
		cursor: pointer;
	}

	i.fa {
		font-size: 13px;
	}
	i.fa.fa-circle, i.fa.fa-circle-o {
		font-size: 11px;
	}
	div.cmpt-ui-grid {
		border-right: 1px solid #cfcfcf;
	}

	.grid-row  {
		background-color: #fff;
	}

	.grid-cell {
		padding-top: 13px;
	}

	.grid-cell * {
		height: 18px; //stop cutting off lowercase g and y, etc
	}

	.row-content {
	    font-size: 13px;
	}

	#saapBanner {
		font-size: 15px;
		line-height: 22px;
		background-color: #EFF3F6;
		padding-top: 15px;
		padding-left: 10px;
		padding-right: 5px;
		padding-bottom: 10px;
		margin-top: -30px;
		margin-bottom: 20px;
	    border-bottom: 1px solid #be81c7;
    	border-left: 1px solid #be81c7;
    	border-right: 1px solid #be81c7;


		i {
			color: #BE81C7;
			font-size: 30px;
			padding-left: 5px;
		}
		#divOverview {
			width: 78%;
			span.warning {
				color: #e66e64;
				font-weight: bold;
			}
		}
		#divBtn {
			padding-right: 5px;
			#btnBackToNew {
				width: 127px;
			}
		}				

		div.saapItem {
			display: inline-block;
			padding-left: 7px;
			padding-right: 7px;
			margin-right: 5px;
			padding-bottom: 6px;
			vertical-align:middle;
		}
	}

	#hdrFilters {
		margin-bottom: 20px;
		border-bottom: 1px solid #cfcfcf;
		div.hdrFilter {
			display: inline-block;
			padding-left: 7px;
			padding-right: 7px;
			margin-right: 10px;
			cursor: pointer;
			padding-bottom: 6px;
			font-size: 14px;
			&.selected{
				border-bottom: 4px solid ap-purple;
				color: #7e3e82;
			}

		}
		span.number {
			background-color: #474747;
			border-radius: 25px;
			padding-left: 8px;
			padding-right: 8px;
			color: white;
			font-size: 11px;
			display: inline-block;
			height: 20px;
			line-height: 20px;
		}
	}

	#searchArea {
		height: 65px;
		padding-left: 10px;
		background-color: ap-light-grey-5;
  		border: solid 0.5px grid-borderColor;
  		border-bottom: 0px; //hide the bottom. the grid has it's own border
    	padding-top: 17px;
    	#searchText {
			margin-right: 15px;
			width: 300px;
			border: 1px solid ap-dark-grey-4;
			box-sizing: border-box;
			height: 30px;
			padding-left: 26px;
		}

		.search-icon {
			z-index: 1;
			text-align: center;
			position: relative;
			left: 30px;
			transform: translateY(-50%);
			height: 30px;
			line-height: 30px;
			color: ap-dark-grey-3;
			font-size: 13px
		}

		#numUsers {
			font-size: 14px;
		}

		.exit-single-user {
			margin-left: 10px;
		}
		.actions, .num-users,.only-show-selected,.clear-all{
			margin-right: 20px;
		}
		.only-show-selected{
			label{
				font-size: 13px;
				input{
					vertical-align: middle;
					margin-right: 5px;
				}
			}
		}
		.actions{
				&.quick-action-dropdown {
					display: inline-block;
					user-select: none;
					z-index: 5;
					.fl-button {
						text-align: left;
					}
					.dropdown {
						font-size: 14px;
						padding: 3px 0;
						display: none;
						position: absolute;
						background-color: backGroundColor;
						left: 10px;
						margin-top:5px;
						width: 200px;
						z-index: 5;
						box-shadow: 0px 2px 5px boxShadow;
						border-radius: 5px;
						&.active {
							display: block;
						}
						li {
							cursor: pointer;
							display: block;
							padding: 5px 12px;
							border-bottom: 1px solid ap-dark-grey-4;
							&:last-child{
								border-bottom: 0;
							}
						}
					}
				}
		}
	}



	a.userLink {
		margin-right: 6px;
	}

	div.below-grid {
		text-align: center;
		margin-top: 10px;
		div.paging-loader {
			border: 1px solid #cfcfcf;
			width: 100%;
    		top: -11px;
    		position: relative;
    		height: 50px;
    		div.loading-container {
    			top: -5px;
    		}
		}
		button {
			margin-left: 10px;
		}
		#xOfy {
			font-size: 13px;
    		margin-bottom: 5px;
    		font-weight: 600;
    		color: #858585;
		}
		.cmpt-ui-loader{
			.loading-container{
				margin: 0;
			}
			.cover{
				background-color: transparent;
			}
		}
	}

	.cmpt-ui-grid{
		.grid-header{
			.selection-th{
				text-align: center;
			}
		}
		.grid-rows{
			.selection-cell{
				padding: 10px;
				text-align: center;
				input{
					vertical-align: middle;
				}
			}
		}
	}

}

	div.qtipEmail {
		padding: 4px;
		box-sizing: border-box;

		div.label {
			color: ap-dark-grey-3;
			margin-bottom: 4px;
		}
		span.actions {
			margin-left: 20px;

		}
		span.email {
			display: inline-block;
			max-width: 220px;
			width: 220px;
			text-overflow: ellipsis;
			white-space: nowrap;
			float: left;
			overflow: hidden;
			word-wrap: normal;
		}
		span.actions {
			display: inline-block;
			float: right;
		}
		span.actions a {
			color: white;
			text-decoration: underline;
			text-transform: lowercase;

		}
	}
