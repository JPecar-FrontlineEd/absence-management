@import "common-var"
.route-reports-subtitute-sub-call-history {

	.content-panel {
		.cmpt-ui-sortable-grid {
			.SubFullName-cell {
				padding-right: 5px;
			}
			.StartTime-th.sorted {
				background-image: gradientBar;
			}
		}
	}

	.totals {
		background-color: backGroundColor;
		font-size: 12px;
		font-weight: bold;
		border-top: 2px solid borderColor;
		div {
			padding: 6px 5px 6px 10px;
			display: inline-block;
		}
		div:last-child {
			border-left: 1px solid borderColor;
		}
	}
}
