@import "common-var"

.route-reports-report-writer-view {
	margin-top: 20px;

	h3 {
		margin-bottom: 5px;
	}

	.title-label {
		font-size: 12px;
		font-weight: bold;
		color: subTitle-color-darkest;
	}
	.caption-data {
		font-size: 12px;
		color: subTitle-color-dark;
	}

	.reports-link {
		float: right;
	}

	.report-actions {
		background: backGroundColor;
		border-radius: 5px;
		box-shadow: 1px 2px 3px 0px boxShadow;
		padding: 10px;
		margin: 10px 0;
		.cmpt-reports-report-writer-actions {
			padding-left: 5px;
			display: inline-block;
			div {
				display: inline-block;
				padding-left: 5px;
			}
		}
	}

	.details-header {
		background: grid-group-title-backGroundColor;
		padding: 5px 5px 0 3px;
		.label {
			margin-left: 5px;
			font-size: 14px;
			font-weight: bold;
			color: ap-light-grey-4;
		}
	}
	.report-details {
		font-size: 13px;
		border: 5px solid content-panel-borderColor;
		background: backGroundColor;
	}

	.cmpt-reports-filter-panel {
		.action-section	{
			display: inline-block;
			margin-top: 0;
			margin-left: 10px;
		}
	}

	.content-panel {
   		border-top: 4px solid content-panel-borderColor;
		margin-top: 15px;
		.cmpt-ui-grouped-grid {
			.no-data {
				font-size: 20px;
				font-weight: bold;
				height: 75px;
				line-height:75px;
			}
		}
		&.no-results {
			.grid-header div {
				display: none;
			}
		}
		.view-details {
			float: right;
  			margin-right: 12px;
  			top: -2px;
  			position: relative;
		}
	}
}


.report-standards.route-reports-report-writer-view {
	.content-panel .grid-header {
		display: block;
	}
}
