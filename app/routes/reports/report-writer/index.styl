@import "common-var"

.route-reports-report-writer-index {
	.report-group {
		margin-top: 20px;
	}

	.grid-rows .grid-row {
		.executionCount-cell, .privacyLevel-cell {
			text-align: center;
			padding: 10px;
		}
	}

	.no-data {
		text-align: center;
		font-size: 20px;
		font-weight: bold;
		height: 75px;
		line-height: 75px;
	}

	.no-records {
		margin-top: 30px;
	}

	.content-panel {
   		border-top: 4px solid content-panel-borderColor;

   		&.no-records {
			.cmpt-ui-loader {
				.loading-container {
					top: 10px;
				}
			}
		}
	}

}


.report-standards.route-reports-report-writer-index {
	h3 {
		margin-top: 30px;
	}
	.content-panel .grid-header {
		display: block;
	}
	.header .count {
		display: none;
	}
}

.absencetrendreporttooltip {
  background: rgba(65, 76, 86, 0.9);
  border-radius: 5px;
  font-size: 14px;
  color: #fff;
  padding: 15px;
  width: 350px;
}