.dialog-popup.download-details {

	.date {
		font-weight: 600;
  		margin-bottom: 0.5rem;
	}

	.main-instructions {
		margin-bottom: 0.5rem;
	}

	select {
		font-size: 14px;
		margin-left: 5px;
	}

	.email-instructions {
		border-top: 1px solid borderColor-light;
  		padding-top: 0.8rem;
		margin-top: 1rem;
  		margin-bottom: 0.5rem;
	}

	.email-input {
		input {
			width: 275px;
		}
	}

	.validation, .radio-options .validation {
		display: inline-block;
		margin-left: 5px;
		color: ap-red;
		font-size: 13px;
	}

	.disabled {
		opacity: .4;
	}
}


.ngdialog.download-details-dialog .ngdialog-content {
	width: 510px;
}
