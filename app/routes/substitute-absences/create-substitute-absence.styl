@import "common-var"
.route-substitute-absences-create-substitute-absence {
	.title {
		float:left;
		h5 {
			line-height: 30px;
			font-weight: bold;
		}
	}

	div.top {
		background: gradient-blueBar-backGroundColor;
		background: gradient-blueBar;
		border-bottom: 1px solid gradient-blueBar-borderColor;
		color: gradient-blueBar-color;
		padding: 10px;
		width: 100%;

		.left-section {
			span.button-section {
				display: none;
			}
		}
	}

	div.bottom {
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		border-top: 1px solid borderColor-medium;
		padding: 10px 12px;
		text-align: right;
		width: 100%;

		.left-section {
			span.button-section {
				display: none;
			}
		}
	}
	.body-section {
		background: backGroundColor-dark;
	}

	.search-by-letter {
		border-right: 1px solid borderColor-medium;
	}

	.cmpt-template-substitute-link {
		display: inline;
	}
}
