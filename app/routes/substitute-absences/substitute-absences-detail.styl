@import "common-var"
.route-substitute-absences-substitute-absences-detail {
	.cmpt-ui-tabs {
			.tabs {
				a {
				width:200px;
				&.locked:before{
					content: '\f023';
					margin-right: 10px;
				    vertical-align: middle;
				    font-size: 14px;
				    color: subTitle-color-darkest;
				}
				&.active:before{
				    color: grid-group-title-color;
				}
			}
		}
	}

	.summary-header{

		margin-bottom: 10px;
		.left-section {
			font-size:14px;
			text-align:left;
		}
		.right-section{
			font-size:14px;
			text-align:right;
			color: subTitle-color-dark;
		}
		.bold {
			font-weight: 700;
		}
		.date{
			font-size:20px;
		}
	}


}
