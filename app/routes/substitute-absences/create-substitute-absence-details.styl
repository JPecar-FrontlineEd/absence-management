@import "common-var"
.route-substitute-absences-create-substitute-absence-details {
	.title {
		float:left;
		h5 {
			line-height: 30px;
			font-weight: bold;
		}
	}

	div.top {
		background: gradient-blueBar-backGroundColor;
		background: gradient-blueBar;
		border-bottom: 1px solid gradient-blueBar-borderColor;
		color: gradient-blueBar-color;
		padding: 10px;
		width: 100%;

		.left-section {
			span.button-section {
				display: none;
			}
		}
	}

	div.bottom {
		background: greyBar-backGroundColor;
		color: subTitle-color-darkest;
		border-top: 1px solid borderColor-medium;
		padding: 10px 12px;
		text-align: right;
		width: 100%;


	}
	.bold{
		font-weight:bold;
	}
	.cmpt-substitute-absence-buttons{
		display: none;
	}
	.cmpt-template-substitute-link {
		display: inline;
		margin-left: 4px;
		font-weight: bold;
	}
	.cmpt-template-institution-link {
		display: inline;
	}
}
