@import "common-var"

.route-search-search {
    #addOptionsDropdown{
        float: right;
        .a{
            color: #40404;
        }
		.dropbtn {
            background: linear-gradient(#fff, #ebeff2);
            border-radius: 2px;
            color: #20242b !important;
            font-family: Open Sans, sans-serif;
            font-size: 0.938rem;
            font-weight: 400;
            padding: 0.156rem 0.625rem 0.156rem 0.625rem;
            border: 1px solid #bcc6d4;
            cursor: pointer;
            display: flex;
}
.dropbtn:hover{
  background-image: linear-gradient(#fbfcfd, #d5dbe1) !important;
}
.dropdown-arrow{
    margin-top: 0.438rem;
    padding-left: 0.125rem;
    margin-left: 0.313rem !important;
}
.arrow-color {
    color: #bcc6d4;
}


#addOptionsDropdownContent{
    right: 0;
    width: max-content;
}

.dropbtn:hover, .dropbtn:focus {
  background-color: #40404;
}

.dropdown {
  position: relative;
  display: inline-block;
}

.dropdown-content {
  display: none;
  position: absolute;
  background-color: white;
  min-width: 10rem;
  overflow: auto;
  box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
  z-index: 1;
}

.dropdown-content a {
    color: #000;
    padding: 0.5rem 1rem;
    text-decoration: none;
    display: block;
    font-size: 0.938rem;
}

.dropdown a:hover {background-color: #f5f5f5;}

.show {display: block;}
	}
    .searchTitle{
        width: fit-content;
    }
    .globalSearchTitle {
        display: inline-flex;
        div.searchSubTitle {
            padding: 0.75rem;
            font-size: 1rem;
        }
    }
}
.main-content {
    padding-left: 0px !important;
}