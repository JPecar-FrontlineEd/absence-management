.route-webtime-webtime-timesheet-summary {
	.order-by{
		width: auto;
	}
	.time-sheet{
		width: 67%;
	}
	.grid-header{
		div{
			height: 60px;
		}
	}
	.grid-row{
		.grid-cell *{
			white-space:pre-wrap;
			font-size:11px;
		}
	}
	.grid-footer{
		.Total-cell{
			span{
				margin-right: 20px;
			}
		}
	}
	.grand-total{
		padding:10px;
		span{
			margin-right:20px;
		}
	}
}