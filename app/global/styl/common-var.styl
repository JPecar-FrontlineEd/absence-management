// Dashboard
circleGaugeSize = 100px;

// z-indexes
z-index-base = 10;
z-index-nav = 5000;
z-index-modal = 9000;

/* gradient bars */

  /* Grey Bar */

  gradientBar = linear-gradient(-180deg,ap-light-grey-3 0,ap-light-grey-1 100%);
  gradientBar-reverse = linear-gradient(-180deg,ap-light-grey-1 0,ap-light-grey-3 100%);

  gradientBarLight = linear-gradient(-180deg,lighten(ap-light-grey-3,20%) 0,lighten(ap-light-grey-1,20%) 100%);
  gradientBarLight-reverse = linear-gradient(-180deg,lighten(ap-light-grey-1,20%) 0,lighten(ap-light-grey-3,20%) 100%);

  /* Blue Bar */
  gradient-blueBar-backGroundColor = gradient-blue-light;
  gradient-blueBar-borderColor = darken(ap-light-blue, 17%);
  gradient-blue-dark = darken(ap-light-blue, 10%);
  gradient-blue-light = darken(ap-light-blue,2%);
  gradient-blueBar-color = #345;
  gradient-blueBar = linear-gradient(-180deg, gradient-blue-light 0,gradient-blue-dark 100%);
  gradient-blueBar-reverse = linear-gradient(-180deg, gradient-blue-dark 0,gradient-blue-light 100%);

  /* Light Blue Bar */
  gradient-lightBlueBar-backGroundColor = lighten(gradient-blue-light,20%);
  gradient-lightBlueBar-borderColor = darken(ap-light-blue, 10%);
  gradient-lightBlue-dark = darken(ap-light-blue, 2%);
  gradient-lightBlue-light = lighten(ap-light-blue,10%);
  gradient-lightBlueBar-color = #345;
  gradient-lightBlueBar = linear-gradient(-180deg, gradient-lightBlue-light 0,gradient-lightBlue-dark 100%);
  gradient-lightBlueBar-reverse = linear-gradient(-180deg, gradient-lightBlue-dark 0,gradient-lightBlue-light 100%);


  /* Green Bar */
  gradient-greenBar-backGroundColor = ap-light-green;
  gradient-greenBar-borderColor = ap-dark-green;
  gradient-green-dark = ap-light-green;
  gradient-green-light = #ddeedd;
  gradient-greenBar-color = subTitle-color-darkest;
  gradient-greenBar = linear-gradient(-180deg, gradient-green-dark 0,gradient-green-light 100%);
  gradient-greenBar-reverse = linear-gradient(-180deg, gradient-green-light 0,gradient-green-dark 100%);

  /* Red Bar */
  gradient-redBar-backGroundColor = lighten(ap-red,50%);
  gradient-redBar-borderColor = lighten(ap-red, 50%);
  gradient-red-dark = lighten(ap-red, 55%);
  gradient-red-light = lighten(ap-red,75%);
  gradient-redBar-color = #345;
  gradient-redBar = linear-gradient(-180deg, gradient-red-light 0,gradient-red-dark 100%);
  gradient-redBar-reverse = linear-gradient(-180deg, gradient-red-dark 0,gradient-red-light 100%);



