@import "common-var"
.loader {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: z-index-nav;
	opacity: 1;

	&.ng-hide-add, &.ng-hide-remove {
		display: block !important;
	}

	&.ng-hide-add {
		transition: opacity linear 200ms;
	}

	&.ng-hide {
		opacity: 0;
	}

	.logo-spinner {
		bottom: 0;
		height: 0px;
		left: 0;
		margin: 21px auto;
		position: absolute;
		top: 0;
		right: 0;
		width: 60px;
	}

	.loading {
		margin-top: 0;
		margin-bottom: 5px;
		font-family: open sans;
		font-weight: 600;
		color: backGroundColor;
		text-align: center;
		text-transform: uppercase;
		font-size: 9px;
		display: block;
	}

	.bar {
		height: 25px;
		width: 5px;
		background: backGroundColor;
		display: block;
		float: left;
		margin-left: 4px;
		animation: height-change 600ms ease-in-out infinite alternate;
	}

	for n in (1..6) {
		.bar-{n} {
			animation-delay: (75 * (n - 1)) ms;
		}
	}
}

.first-loader {
	@extend .loader;

	progbar-width = 82px;

	background-color:backGroundColor;
	transition: none !important;

	.logo-spinner {
		width: progbar-width;
		margin: auto;
		transform-origin: 50% 50%;
		transform: scale(1, 1);
		opacity: 1;
	}

	.loading {
		width: progbar-width;
		margin-top: 5px;
		color:  subTitle-color-light;
		animation: pulse 1s ease-in-out infinite;
	}

	.progress-bar{
		display: block;
		height: 8px;
		width: progbar-width;
		background: progressBar-backGroundColor;
		overflow: hidden;

		.progress {
			display: block;
			height: 100%;
			width: 100%;
			transform: translateX(-100%);
			transition: transform 300ms ease-in-out;
			background-color: topbar-bg-light;
		}
	}

	&.ng-hide-animate {
		animation: preload-hide 600ms;
		display: block;
		opacity: 1;

		.logo-spinner {
			transition: all 200ms ease-in-out;
			transform: scale(0.8, 0.8);
			opacity: 0;

			.progress {
				transform: translateX(0%) !important;
				transition: none !important;
			}
		}
	}
}


.report-loader {
	@extend .loader;

	.logo-spinner {

		left: auto;
		margin: 0;
		position: absolute;
		top: 17px;
		right: 9px;
		width: 60px;
	}

	for n in (1..6) {
		.bar-{n} {
			animation-delay: (75 * (n - 1)) ms;
		}
	}
}


.bar:first-of-type {
	margin-left: 0;
}

@keyframes preload-hide {
	0% {
		opacity: 1;
	}

	70% {
		opacity: 1;
	}
	100% {
		opacity: 0;
	}
}

@keyframes pulse {
	0% {
		opacity: 1;
	}
	50% {
		opacity: 0.5;
	}
	100% {
		opacity: 1;
	}
}

@keyframes height-change {
	0% {
		height: 22px;
		background:rgba(255,255,255,.65);
	}
	50% {
		height: 15px;
		background:rgba(255,255,255,.85);
	}
	100% {
		height: 15px;
		background:rgba(255,255,255,1);
	}
}

@keyframes height-change-blue {
	0% {
		height: 22px;
		background: rgba(67, 112, 159, 1);
	}
	50% {
		height: 15px;
		background: rgba(83, 133, 184, 1);

	}
	100% {
		height: 15px;
		background: rgba(83, 133, 184, 1);

	}
}
