
/* Colors */

fl-gray = #9AA9AA;
fl-darkgray =  #2e3439;
fl-blue = #2387B9;
fl-green = #26A26A;
fl-yellow = #D6AD6A;
fl-red = #E55E55;

/* Blues */
fl-blue-1 = lighten(fl-blue, 15%);
fl-blue-2 = lighten(fl-blue, 25%);

/* Grays */
fl-gray-1 = lighten(fl-gray, 15%);
fl-gray-2 = lighten(fl-gray, 25%);
fl-gray-3 = lighten(fl-gray, 30%);
fl-gray-4 = lighten(fl-gray, 35%);
fl-gray-5 = lighten(fl-gray, 50%);

/* Dark Grays */
fl-darkgray-1 = lighten(fl-darkgray, 15%);
fl-darkgray-2 = lighten(fl-darkgray, 25%);
fl-darkgray-3 = lighten(fl-darkgray, 35%);

/* Typography */
fl-text-light =			#ffffff;
fl-text-gray =			#838383;
fl-text-dark-gray =		#646464;
fl-text-darkest-gray = 	#303030;

fl-text-blue =			fl-blue;
fl-text-dark-blue = darken(fl-blue, 25%);


/* Element Colors */
fl-background = #f0f0f0;
fl-panel-white = #fff;
fl-link-blue = darken(fl-blue, 25%);

// Colors v2 (deprecated)
flv2-light-blue = #5385B8;
flv2-gray = #97999C;
flv2-light-gray = lighten(flv2-gray, 40%);
flv2-lighter-gray = lighten(flv2-gray, 70%);
flv2-lightest-gray = lighten(flv2-gray, 90%);
flv2-dark-gray = #464646;
flv2-darker-gray = #2E3439;
flv2-darkest-gray = #2C2F34;

// Typography (deprecated)
flv2-text-light = fl-text-light;
flv2-text-gray = fl-text-gray;
flv2-text-dark-gray = fl-text-dark-gray;
flv2-text-darkest-gray = fl-text-darkest-gray;
flv2-text-blue = fl-text-blue;


// Global
unfilledAbsenceColor = #CC9900;
filledAbsenceColor = #2d7b50;
