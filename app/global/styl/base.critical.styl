@import 'common-var'

html {
	height: 100%;
	background-color: html-backGroundColor;
	color: ap-dark-grey-1;
	font: normal 100%/1.75 'Open Sans', Helvetica, Arial, sans-serif;
	box-sizing: border-box;
}

body {
	background: body-backGroundColor;
	min-width: content-width;
	height: 100%;
	-webkit-text-size-adjust: none;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
	text-rendering: optimizeLegibility;
}

body.hide-overflow{
	overflow: hidden;
}

*, *:before, *:after {
	box-sizing: inherit;
}

a {
	color: anchor-tag-blue;
	text-decoration: none;
	line-height: normal;
	opacity: .8;
}

a:not([class*='fl-button']):hover {
	opacity: 1;
	text-decoration: underline;
}

a:not([class*='fl-button']):focus {
	outline: none;
	text-decoration: underline;
}

ul {
	list-style: none;
}

