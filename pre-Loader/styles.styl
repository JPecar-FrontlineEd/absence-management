$fl-brand-primary = #7E4082;
$fl-brand-primary-lt = #BE81C7;
$fl-brand-primary-dk = #402B56;


@keyframes pre-loader-height-change {
	0% {
		height: 22px
		opacity: 1
		background-color: $fl-brand-primary-lt
	}

	50% {
		height: 15px
		opacity: 0.7
		background-color: $fl-brand-primary-lt
	}

	100% {
		height: 15px
		opacity: 0.7
		background-color: $fl-brand-primary-lt
	}
}


.loading-container {
	position: relative
	height: 25px
	width: 50px
	margin: 20px auto;
}

.logo-spinner {

	.bar {
		height: 22px
		width: 5px
		background: $fl-brand-primary
		display: block
		float: left
		margin-left: 4px
		animation: height-change 600ms ease-in-out infinite alternate
	}

	.bar:first-of-type {
		margin-left: 0
	}

	.bar-1 {
		animation-delay: 0
	}

	.bar-2 {
		animation-delay: 75ms
	}

	.bar-3 {
		animation-delay: 150ms
	}

	.bar-4 {
		animation-delay: 225ms
	}

	.bar-5 {
		animation-delay: 300ms
	}

	.bar-6 {
		animation-delay: 375ms
	}
}

#pre-loader {
	position: fixed
	top: 0
	right: 0
	bottom: 0
	left: 0
	background-color: $fl-brand-primary-dk
	//opacity: 1
	transition(opacity 200ms)
	z-index: 9999999999

	.pre-loader-content {
		absolute: top 50% left 50%
		transform: translate(-50%, -50%)
	}

	.pre-loader-badge {
		background-image: $fl-logo
		background-size: 270px 75px;
		width: 270px;
		height: 75px;
		background-repeat: no-repeat;		
	}

	.bar {
		animation-name: pre-loader-height-change
	}

	// &.ng-hide-add, &.ng-hide-remove {
	// 	display: block !important
	// }
	//
	// &.ng-hide {
	// 	opacity: 0
	// }
}

.loader {
	width: 50px
	height: 50px
	margin-left: auto
	margin-right: auto
	overflow: hidden
}

.loading {
	margin-top: 0
	margin-bottom: 5px
	font-family: 'Open Sans'
	font-weight: 600
	color: rgba(80, 119, 160, 1)
	text-align: center
	text-transform: uppercase
	font-size: 9px
}
